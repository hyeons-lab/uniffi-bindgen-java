// === FILE: uniffi/fixture/proc_macro/FfiConverterMapByteLong.kt ===
package uniffi.fixture.proc_macro

object FfiConverterMapByteLong : FfiConverterRustBuffer<Map<kotlin.Byte, kotlin.Long>> {
    override fun read(buf: java.nio.ByteBuffer): Map<kotlin.Byte, kotlin.Long> {
        val len = buf.getInt()
        val map = HashMap<kotlin.Byte, kotlin.Long>(len)
        repeat(len) {
            val k = FfiConverterByte.read(buf)
            val v = FfiConverterLong.read(buf)
            map[k] = v
        }
        return map
    }

    override fun allocationSize(value: Map<kotlin.Byte, kotlin.Long>): Long {
        return 4L + value.entries.sumOf {
            FfiConverterByte.allocationSize(it.key) + FfiConverterLong.allocationSize(it.value)
        }
    }

    override fun write(value: Map<kotlin.Byte, kotlin.Long>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        for ((k, v) in value) {
            FfiConverterByte.write(k, buf)
            FfiConverterLong.write(v, buf)
        }
    }
}

