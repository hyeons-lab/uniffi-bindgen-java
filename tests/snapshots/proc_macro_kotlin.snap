object FfiConverterOptionalTypeTwo : FfiConverterRustBuffer<Two?> {
    override fun read(buf: java.nio.ByteBuffer): Two? {
        if (buf.get() == 0.toByte()) {
            return null
        }
        return FfiConverterTypeTwo.read(buf)
    }

    override fun allocationSize(value: Two?): Long {
        if (value == null) {
            return 1L
        }
        return 1L + FfiConverterTypeTwo.allocationSize(value)
    }

    override fun write(value: Two?, buf: java.nio.ByteBuffer) {
        if (value == null) {
            buf.put(0.toByte())
        } else {
            buf.put(1.toByte())
            FfiConverterTypeTwo.write(value, buf)
        }
    }
}

