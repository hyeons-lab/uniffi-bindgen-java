// === FILE: uniffi/fixture/proc_macro/FfiConverterOptionalBooleanArray.kt ===
package uniffi.fixture.proc_macro

// Kotlin uses its type system to express nullability directly via `T?`,
// so the `lift` / `lower` boundary handles a null sentinel byte without
// any wrapper class on the Kotlin side.
object FfiConverterOptionalBooleanArray : FfiConverterRustBuffer<BooleanArray?> {
    override fun read(buf: java.nio.ByteBuffer): BooleanArray? {
        if (buf.get() == 0.toByte()) {
            return null
        }
        return FfiConverterBooleanArray.read(buf)
    }

    override fun allocationSize(value: BooleanArray?): Long {
        if (value == null) {
            return 1L
        }
        return 1L + FfiConverterBooleanArray.allocationSize(value)
    }

    override fun write(value: BooleanArray?, buf: java.nio.ByteBuffer) {
        if (value == null) {
            buf.put(0.toByte())
        } else {
            buf.put(1.toByte())
            FfiConverterBooleanArray.write(value, buf)
        }
    }
}

