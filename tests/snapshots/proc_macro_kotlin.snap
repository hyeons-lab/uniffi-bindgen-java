        )
        UniffiVTableCallbackInterfaceTraitWithForeign.setname(
            vtable,
            UniffiCallbackInterfaceTraitWithForeignMethod0.toUpcallStub(NameCallback, java.lang.foreign.Arena.global()),
        )
    }

