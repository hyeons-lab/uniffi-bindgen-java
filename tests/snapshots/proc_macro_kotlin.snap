            check(c != 0L) { "StructWithTrait object has already been destroyed" }
            check(c != Long.MAX_VALUE) { "StructWithTrait call counter would overflow" }
        } while (!callCounter.compareAndSet(c, c + 1L))
        try {
            return block(uniffiCloneHandle())
        } finally {
