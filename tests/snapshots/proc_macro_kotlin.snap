    override fun write(value: Trait, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

// === FILE: uniffi/fixture/proc_macro/FfiConverterTypeTraitWithForeign.kt ===
package uniffi.fixture.proc_macro
// LSB-tagged FfiConverter for `[Trait, WithForeign]` objects. Rust-side
// instances are wrapped by `TraitWithForeignImpl` and carry even
// handles (LSB = 0); Kotlin-side implementations of the TraitWithForeign
// trait get registered in the per-FfiConverter `handleMap` and carry
// odd handles (LSB = 1). `lift` / `lower` dispatch on the LSB to route
// to the right side without an extra type tag.
internal object FfiConverterTypeTraitWithForeign : FfiConverter<TraitWithForeign, Long> {
    @JvmField internal val handleMap: UniffiHandleMap<TraitWithForeign> = UniffiHandleMap()

    override fun lower(value: TraitWithForeign): Long =
        if (value is TraitWithForeignImpl) {
            value.uniffiCloneHandle()
        } else {
            handleMap.insert(value)
        }

    override fun lift(value: Long): TraitWithForeign =
        if ((value and 1L) == 0L) {
            TraitWithForeignImpl(UniffiWithHandle, value)
        } else {
            handleMap.remove(value)
        }

    override fun read(buf: java.nio.ByteBuffer): TraitWithForeign = lift(buf.getLong())

    override fun allocationSize(value: TraitWithForeign): Long = 8L

    override fun write(value: TraitWithForeign, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

