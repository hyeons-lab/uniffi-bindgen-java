    override fun addToNum(other: kotlin.Int): kotlin.Int =
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallInt { _, _status ->
                UniffiLib.uniffi_uniffi_proc_macro_fn_method_objectwithdefaults_add_to_num(uniffiHandle, other, _status)
            }
        }
    
}


