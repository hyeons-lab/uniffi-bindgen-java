                FfiConverterLong.read(buf)
            )
            4 -> MixedEnum.Both(
                FfiConverterString.read(buf),
                FfiConverterLong.read(buf)
            )
            5 -> MixedEnum.All(
                FfiConverterString.read(buf),
                FfiConverterLong.read(buf)
            )
            6 -> MixedEnum.Vec(
                FfiConverterSequenceString.read(buf)
            )
            else -> throw RuntimeException("invalid enum value, something is very wrong!")
        }

    override fun allocationSize(value: MixedEnum): Long =
        when (value) {
            is MixedEnum.None -> (
                4L
            )
            is MixedEnum.String -> (
                4L
                + FfiConverterString.allocationSize(value.v1)
            )
            is MixedEnum.Int -> (
                4L
                + FfiConverterLong.allocationSize(value.v1)
            )
            is MixedEnum.Both -> (
                4L
                + FfiConverterString.allocationSize(value.v1)
                + FfiConverterLong.allocationSize(value.v2)
            )
            is MixedEnum.All -> (
                4L
                + FfiConverterString.allocationSize(value.s)
                + FfiConverterLong.allocationSize(value.i)
            )
            is MixedEnum.Vec -> (
                4L
                + FfiConverterSequenceString.allocationSize(value.v1)
            )
        }

    override fun write(value: MixedEnum, buf: java.nio.ByteBuffer) {
        when (value) {
            is MixedEnum.None -> {
                buf.putInt(1)
            }
            is MixedEnum.String -> {
                buf.putInt(2)
                FfiConverterString.write(value.v1, buf)
            }
            is MixedEnum.Int -> {
                buf.putInt(3)
                FfiConverterLong.write(value.v1, buf)
            }
            is MixedEnum.Both -> {
                buf.putInt(4)
                FfiConverterString.write(value.v1, buf)
                FfiConverterLong.write(value.v2, buf)
            }
            is MixedEnum.All -> {
                buf.putInt(5)
                FfiConverterString.write(value.s, buf)
                FfiConverterLong.write(value.i, buf)
            }
            is MixedEnum.Vec -> {
                buf.putInt(6)
                FfiConverterSequenceString.write(value.v1, buf)
            }
        }
    }
}



