object FfiConverterTypeMixedEnum : FfiConverterRustBuffer<MixedEnum> {
    override fun read(buf: java.nio.ByteBuffer): MixedEnum =
        when (buf.getInt()) {
            1 -> MixedEnum.None
            2 -> MixedEnum.String(
                FfiConverterString.read(buf)
            )
