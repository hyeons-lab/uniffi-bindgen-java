// === FILE: uniffi/primitive_arrays/FfiConverterRustBuffer.kt ===
package uniffi.primitive_arrays

// FfiConverter that uses `RustBuffer` as the FfiType.
interface FfiConverterRustBuffer<T> : FfiConverter<T, java.lang.foreign.MemorySegment> {
    override fun lift(value: java.lang.foreign.MemorySegment): T = liftFromRustBuffer(value)
    override fun lower(value: T): java.lang.foreign.MemorySegment = lowerIntoRustBuffer(value)
}


// === FILE: uniffi/primitive_arrays/FfiConverterSequenceBoolean.kt ===
package uniffi.primitive_arrays

object FfiConverterSequenceBoolean : FfiConverterRustBuffer<List<Boolean>> {
    override fun read(buf: java.nio.ByteBuffer): List<Boolean> {
        val len = buf.getInt()
        val list = ArrayList<Boolean>(len)
        repeat(len) { list.add(FfiConverterBoolean.read(buf)) }
        return list
    }

    override fun allocationSize(value: List<Boolean>): Long {
        return 4L + value.sumOf { FfiConverterBoolean.allocationSize(it) }
    }

    override fun write(value: List<Boolean>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        value.forEach { FfiConverterBoolean.write(it, buf) }
    }
}

