// === FILE: uniffi/trait_with_foreign/UniffiCallbackInterfaceCounter.kt ===
package uniffi.trait_with_foreign

// Vtable assembly + per-method upcall stubs for callback interfaces.
// Each stub pulls the foreign-side object out of the handle map,
// invokes the requested method, and writes the result back into the
// Rust-provided out-param buffer. Mirrors `src/templates/
// CallbackInterfaceImpl.java`, minus the async and error-in-callback
// paths — those land with P3k / P3l respectively.
internal object UniffiCallbackInterfaceCounter {
    internal val vtable: java.lang.foreign.MemorySegment

    init {
        // Arena.global() is load-bearing: vtables and upcall stubs
        // must outlive every FFI call they participate in. Auto arenas
        // would be reclaimable once a reference escapes into a struct,
        // producing use-after-free with delightful debugging traces.
        vtable = java.lang.foreign.Arena.global().allocate(UniffiVTableCallbackInterfaceCounter.LAYOUT)
        UniffiVTableCallbackInterfaceCounter.setuniffiFree(
            vtable,
            UniffiCallbackInterfaceFree.toUpcallStub(UniffiFree, java.lang.foreign.Arena.global()),
        )
        UniffiVTableCallbackInterfaceCounter.setuniffiClone(
            vtable,
            UniffiCallbackInterfaceClone.toUpcallStub(UniffiClone, java.lang.foreign.Arena.global()),
        )
        UniffiVTableCallbackInterfaceCounter.setnextValue(
            vtable,
            UniffiCallbackInterfaceCounterMethod0.toUpcallStub(NextValueCallback, java.lang.foreign.Arena.global()),
        )
    }

    // Registers the vtable with Rust. Called from UniffiLib init via
    // the generator-collected `initialization_fns()` list.
    fun register() {
        UniffiLib.uniffi_uniffi_fixture_trait_with_foreign_fn_init_callback_vtable_counter(vtable)
    }

    internal object NextValueCallback : UniffiCallbackInterfaceCounterMethod0.Fn {
        override fun callback(
            uniffiHandle: Long,
            uniffiOutReturn: java.lang.foreign.MemorySegment,
            uniffiCallStatus: java.lang.foreign.MemorySegment,
        ) {
            val uniffiCallStatusReinterpreted = uniffiCallStatus.reinterpret(UniffiRustCallStatus.LAYOUT.byteSize())
            val uniffiObj = FfiConverterTypeCounter.handleMap.get(uniffiHandle)
            val makeCall = java.util.function.Supplier {
                uniffiObj.nextValue(
                )
            }
            val writeReturn = java.util.function.Consumer<kotlin.Int> { uniffiValue ->
                val outReturn = uniffiOutReturn.reinterpret(java.lang.foreign.ValueLayout.JAVA_INT.byteSize())
                outReturn.set(java.lang.foreign.ValueLayout.JAVA_INT_UNALIGNED, 0L, FfiConverterInt.lower(uniffiValue))
            }
            UniffiHelpers.uniffiTraitInterfaceCall(uniffiCallStatusReinterpreted, makeCall, writeReturn)
        }
    }

    // Free — Rust drops the handle; we remove from the map.
    internal object UniffiFree : UniffiCallbackInterfaceFree.Fn {
        override fun callback(handle: Long) {
            FfiConverterTypeCounter.handleMap.remove(handle)
        }
    }

    // Clone — Rust wants another reference; we clone in the map.
    internal object UniffiClone : UniffiCallbackInterfaceClone.Fn {
        override fun callback(handle: Long): Long =
            FfiConverterTypeCounter.handleMap.clone(handle)
    }
}

// Public top-level entry point so a downstream crate's `UniffiLib`
// init can register this vtable across module boundaries. The
// `internal object UniffiCallbackInterfaceCounter` itself can't be referenced
// from outside its compile module (Kotlin `internal` is module-
// scoped); proxying through a public function exposes only the
// `register()` entry without leaking the rest of the internal
// surface (`vtable`, upcall stub objects, etc.).
fun registerUniffiCallbackInterfaceCounter() = UniffiCallbackInterfaceCounter.register()


