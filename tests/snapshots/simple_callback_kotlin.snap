        FfiConverterString.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_uniffi_fixture_simple_callback_fn_func_invoke_greeter(_allocator, FfiConverterTypeGreeter.lower(greeter), FfiConverterString.lower(name), _status)
            }
        )
}
// === FILE: uniffi/simple_callback/UniffiCallbackInterfaceClone.kt ===
package uniffi.simple_callback

internal object UniffiCallbackInterfaceClone {
    val DESCRIPTOR: java.lang.foreign.FunctionDescriptor =
        java.lang.foreign.FunctionDescriptor.of(java.lang.foreign.ValueLayout.JAVA_LONG, java.lang.foreign.ValueLayout.JAVA_LONG)

    fun interface Fn {
        fun callback(
            handle: Long
        ): Long
    }

    fun toUpcallStub(fn: Fn, arena: java.lang.foreign.Arena): java.lang.foreign.MemorySegment {
        try {
            val handle = java.lang.invoke.MethodHandles.lookup()
                .findVirtual(
                    Fn::class.java,
                    "callback",
                    java.lang.invoke.MethodType.methodType(
                        Long::class.javaPrimitiveType ?: Long::class.java,
                        Long::class.javaPrimitiveType ?: Long::class.java
                    ),
                )
                .bindTo(fn)
            return java.lang.foreign.Linker.nativeLinker().upcallStub(handle, DESCRIPTOR, arena)
        } catch (e: ReflectiveOperationException) {
            throw AssertionError("Failed to create upcall stub", e)
        }
    }
}


// === FILE: uniffi/simple_callback/UniffiCallbackInterfaceFree.kt ===
package uniffi.simple_callback

internal object UniffiCallbackInterfaceFree {
    val DESCRIPTOR: java.lang.foreign.FunctionDescriptor =
        java.lang.foreign.FunctionDescriptor.ofVoid(java.lang.foreign.ValueLayout.JAVA_LONG)

    fun interface Fn {
        fun callback(
            handle: Long
        )
    }

    fun toUpcallStub(fn: Fn, arena: java.lang.foreign.Arena): java.lang.foreign.MemorySegment {
        try {
            val handle = java.lang.invoke.MethodHandles.lookup()
                .findVirtual(
                    Fn::class.java,
                    "callback",
                    java.lang.invoke.MethodType.methodType(
                        Void.TYPE,
                        Long::class.javaPrimitiveType ?: Long::class.java
                    ),
                )
                .bindTo(fn)
            return java.lang.foreign.Linker.nativeLinker().upcallStub(handle, DESCRIPTOR, arena)
        } catch (e: ReflectiveOperationException) {
            throw AssertionError("Failed to create upcall stub", e)
        }
    }
}


// === FILE: uniffi/simple_callback/UniffiCallbackInterfaceGreeter.kt ===
package uniffi.simple_callback

// Vtable assembly + per-method upcall stubs for callback interfaces.
// Each stub pulls the foreign-side object out of the handle map,
// invokes the requested method, and writes the result back into the
// Rust-provided out-param buffer. Mirrors `src/templates/
// CallbackInterfaceImpl.java`, minus the async and error-in-callback
// paths — those land with P3k / P3l respectively.
internal object UniffiCallbackInterfaceGreeter {
    internal val vtable: java.lang.foreign.MemorySegment

    init {
        // Arena.global() is load-bearing: vtables and upcall stubs
        // must outlive every FFI call they participate in. Auto arenas
        // would be reclaimable once a reference escapes into a struct,
        // producing use-after-free with delightful debugging traces.
        vtable = java.lang.foreign.Arena.global().allocate(UniffiVTableCallbackInterfaceGreeter.LAYOUT)
        UniffiVTableCallbackInterfaceGreeter.setuniffiFree(
            vtable,
