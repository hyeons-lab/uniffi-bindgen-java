// === FILE: uniffi/coverall/FfiConverterMapIntLong.kt ===
package uniffi.coverall

object FfiConverterMapIntLong : FfiConverterRustBuffer<Map<kotlin.Int, kotlin.Long>> {
    override fun read(buf: java.nio.ByteBuffer): Map<kotlin.Int, kotlin.Long> {
        val len = buf.getInt()
        val map = HashMap<kotlin.Int, kotlin.Long>(len)
        repeat(len) {
            val k = FfiConverterInt.read(buf)
            val v = FfiConverterLong.read(buf)
            map[k] = v
        }
        return map
    }

    override fun allocationSize(value: Map<kotlin.Int, kotlin.Long>): Long {
        return 4L + value.entries.sumOf {
            FfiConverterInt.allocationSize(it.key) + FfiConverterLong.allocationSize(it.value)
        }
    }

    override fun write(value: Map<kotlin.Int, kotlin.Long>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        for ((k, v) in value) {
            FfiConverterInt.write(k, buf)
            FfiConverterLong.write(v, buf)
        }
    }
}

