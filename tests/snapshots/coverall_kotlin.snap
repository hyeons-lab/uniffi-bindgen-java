    fun uniffiRustCallDouble(callback: UniffiRustCallDoubleFunction): Double =
        uniffiRustCallWithErrorDouble(UniffiNullRustCallStatusErrorHandler(), callback)

    fun interface UniffiRustCallBooleanFunction {
        fun apply(allocator: java.lang.foreign.SegmentAllocator, status: java.lang.foreign.MemorySegment): Boolean
    }

    @Throws(Exception::class)
    fun <E : Exception> uniffiRustCallWithErrorBoolean(
        errorHandler: UniffiRustCallStatusErrorHandler<E>,
        callback: UniffiRustCallBooleanFunction,
    ): Boolean {
        val status = REUSABLE_STATUS.get()
        status.fill(0.toByte())
        val returnValue = callback.apply(RETURN_ALLOCATOR, status)
        uniffiCheckCallStatus(errorHandler, status)
        return returnValue
    }

    fun uniffiRustCallBoolean(callback: UniffiRustCallBooleanFunction): Boolean =
        uniffiRustCallWithErrorBoolean(UniffiNullRustCallStatusErrorHandler(), callback)

    // Call a rust function that returns a plain value.
    fun <U> uniffiRustCall(callback: UniffiRustCallFunction<U>): U =
        uniffiRustCallWithError(UniffiNullRustCallStatusErrorHandler(), callback)

    // Call a rust function that returns nothing. Renamed vs
    // `uniffiRustCall` to avoid Kotlin SAM-overload ambiguity.
    fun uniffiRustCallVoid(callback: UniffiRustCallVoidFunction) {
        uniffiRustCallVoidWithError(UniffiNullRustCallStatusErrorHandler(), callback)
    }

    fun <T> uniffiTraitInterfaceCall(
        callStatus: java.lang.foreign.MemorySegment,
        makeCall: java.util.function.Supplier<T>,
        writeReturn: java.util.function.Consumer<T>,
    ) {
        try {
            writeReturn.accept(makeCall.get())
        } catch (e: Exception) {
            UniffiRustCallStatus.setCode(callStatus, UniffiRustCallStatus.UNIFFI_CALL_UNEXPECTED_ERROR)
            UniffiRustCallStatus.setErrorBuf(
                callStatus,
                FfiConverterString.lower(uniffiStackTraceToString(e)),
            )
        }
    }

    private fun uniffiStackTraceToString(e: Throwable): String =
        try {
            val sw = java.io.StringWriter()
            e.printStackTrace(java.io.PrintWriter(sw))
            sw.toString()
        } catch (_: Throwable) {
            e.toString()
        }

    fun <T, E : Throwable> uniffiTraitInterfaceCallWithError(
        callStatus: java.lang.foreign.MemorySegment,
        makeCall: java.util.concurrent.Callable<T>,
        writeReturn: java.util.function.Consumer<T>,
        lowerError: java.util.function.Function<E, java.lang.foreign.MemorySegment>,
        errorClazz: Class<E>,
    ) {
        try {
            writeReturn.accept(makeCall.call())
        } catch (e: Exception) {
            if (errorClazz.isAssignableFrom(e.javaClass)) {
                @Suppress("UNCHECKED_CAST")
                val castedE = e as E
                UniffiRustCallStatus.setCode(callStatus, UniffiRustCallStatus.UNIFFI_CALL_ERROR)
                UniffiRustCallStatus.setErrorBuf(callStatus, lowerError.apply(castedE))
            } else {
                UniffiRustCallStatus.setCode(callStatus, UniffiRustCallStatus.UNIFFI_CALL_UNEXPECTED_ERROR)
                UniffiRustCallStatus.setErrorBuf(
                    callStatus,
                    FfiConverterString.lower(uniffiStackTraceToString(e)),
                )
            }
        }
    }
}

// === FILE: uniffi/coverall/UniffiInitializer.kt ===
package uniffi.coverall

/**
 * Ensures the native library is initialized.
 * Call this function to force initialization before using any types from this library.
 */
object UniffiInitializer {
    /** Force initialization of the native library. */
    fun ensureInitialized() {
        // Force UniffiLib class to load (runs integrity checks and initialization functions).
        @Suppress("UNUSED_VARIABLE")
        val ignored: Class<*> = UniffiLib::class.java
    }
}


// === FILE: uniffi/coverall/UniffiLib.kt ===
package uniffi.coverall

// FFM-based library binding. Each FFI function gets a `MethodHandle` field
// + a wrapper function that performs the `invokeExact` call. The loop
// below iterates `ci.iter_ffi_function_definitions()` so every runtime AND
// per-component FFI function gets bound at class-init time.
internal object UniffiLib {
    private val LINKER: java.lang.foreign.Linker = java.lang.foreign.Linker.nativeLinker()
    private val SYMBOLS: java.lang.foreign.SymbolLookup
    // Library-wide cleaner for object finalization. Instantiated lazily
    // at class-init; every object wrapper registers a
    // `UniffiCleanAction` with this shared cleaner on construction.
    @JvmField internal val CLEANER: UniffiCleaner = UniffiCleaner.create()

    init {
        SYMBOLS = NamespaceLibrary.loadLibrary()
    }

    private fun findDowncallHandle(
        name: String,
        descriptor: java.lang.foreign.FunctionDescriptor,
    ): java.lang.invoke.MethodHandle =
        SYMBOLS.find(name)
            .map { s -> LINKER.downcallHandle(s, descriptor) }
            .orElseThrow { RuntimeException("Missing FFI symbol: $name") }

    // uniffi_uniffi_coverall_fn_clone_coveralls
    private val MH_uniffi_uniffi_coverall_fn_clone_coveralls: java.lang.invoke.MethodHandle = findDowncallHandle(
        "uniffi_uniffi_coverall_fn_clone_coveralls",
        java.lang.foreign.FunctionDescriptor.of(
            java.lang.foreign.ValueLayout.JAVA_LONG,
            java.lang.foreign.ValueLayout.JAVA_LONG,
            java.lang.foreign.ValueLayout.ADDRESS,
        ),
    )

    fun uniffi_uniffi_coverall_fn_clone_coveralls(
        handle: Long,
        uniffiOutErr: java.lang.foreign.MemorySegment,
    ): Long =
        try {
            MH_uniffi_uniffi_coverall_fn_clone_coveralls.invokeExact(
                handle,
                uniffiOutErr,
            ) as Long
        } catch (ex: Throwable) {
            throw AssertionError("invokeExact failed", ex)
        }

    // uniffi_uniffi_coverall_fn_free_coveralls
    private val MH_uniffi_uniffi_coverall_fn_free_coveralls: java.lang.invoke.MethodHandle = findDowncallHandle(
        "uniffi_uniffi_coverall_fn_free_coveralls",
        java.lang.foreign.FunctionDescriptor.ofVoid(
            java.lang.foreign.ValueLayout.JAVA_LONG,
            java.lang.foreign.ValueLayout.ADDRESS,
        ),
    )

