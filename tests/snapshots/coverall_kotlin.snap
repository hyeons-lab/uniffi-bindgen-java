            map[k] = v
        }
        return map
    }

    override fun allocationSize(value: Map<kotlin.String, Coveralls?>): Long {
        return 4L + value.entries.sumOf {
            FfiConverterString.allocationSize(it.key) + FfiConverterOptionalTypeCoveralls.allocationSize(it.value)
        }
    }

    override fun write(value: Map<kotlin.String, Coveralls?>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        for ((k, v) in value) {
            FfiConverterString.write(k, buf)
            FfiConverterOptionalTypeCoveralls.write(v, buf)
        }
