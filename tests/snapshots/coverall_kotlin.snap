            FfiConverterString.allocationSize(it.key) + FfiConverterLong.allocationSize(it.value)
        }
    }

    override fun write(value: Map<kotlin.String, kotlin.Long>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        for ((k, v) in value) {
            FfiConverterString.write(k, buf)
            FfiConverterLong.write(v, buf)
        }
    }
}

// === FILE: uniffi/coverall/FfiConverterMapStringOptionalTypeCoveralls.kt ===
package uniffi.coverall

object FfiConverterMapStringOptionalTypeCoveralls : FfiConverterRustBuffer<Map<kotlin.String, Coveralls?>> {
