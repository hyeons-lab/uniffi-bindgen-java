        }
    }
    
    @Throws(CoverallException::class)
    override fun takeOtherFallible() {
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallVoidWithError(CoverallExceptionErrorHandler()) { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_take_other_fallible(uniffiHandle, _status)
            }
        }
    }
    
    override fun takeOtherPanic(message: kotlin.String) {
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallVoid { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_take_other_panic(uniffiHandle, FfiConverterString.lower(message), _status)
            }
        }
    }
    
    companion object {
        
        @Throws(CoverallException::class)
        @JvmStatic
        fun fallibleNew(name: kotlin.String, shouldFail: kotlin.Boolean): Coveralls =
            Coveralls(
                UniffiWithHandle,
                UniffiHelpers.uniffiRustCallWithError(CoverallExceptionErrorHandler()) { _allocator, _status ->
