// === FILE: uniffi/coverall/FfiConverterMapStringString.kt ===
package uniffi.coverall

object FfiConverterMapStringString : FfiConverterRustBuffer<Map<kotlin.String, kotlin.String>> {
    override fun read(buf: java.nio.ByteBuffer): Map<kotlin.String, kotlin.String> {
        val len = buf.getInt()
        val map = HashMap<kotlin.String, kotlin.String>(len)
        repeat(len) {
            val k = FfiConverterString.read(buf)
            val v = FfiConverterString.read(buf)
            map[k] = v
        }
        return map
    }

    override fun allocationSize(value: Map<kotlin.String, kotlin.String>): Long {
        return 4L + value.entries.sumOf {
            FfiConverterString.allocationSize(it.key) + FfiConverterString.allocationSize(it.value)
        }
    }

    override fun write(value: Map<kotlin.String, kotlin.String>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        for ((k, v) in value) {
            FfiConverterString.write(k, buf)
            FfiConverterString.write(v, buf)
        }
    }
}

// === FILE: uniffi/coverall/FfiConverterMapStringTypeCoverallFlatError.kt ===
package uniffi.coverall

object FfiConverterMapStringTypeCoverallFlatError : FfiConverterRustBuffer<Map<kotlin.String, CoverallFlatException>> {
