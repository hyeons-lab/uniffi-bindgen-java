// === FILE: uniffi/coverall/FfiConverterRustBuffer.kt ===
package uniffi.coverall

// FfiConverter that uses `RustBuffer` as the FfiType.
interface FfiConverterRustBuffer<T> : FfiConverter<T, java.lang.foreign.MemorySegment> {
    override fun lift(value: java.lang.foreign.MemorySegment): T = liftFromRustBuffer(value)
    override fun lower(value: T): java.lang.foreign.MemorySegment = lowerIntoRustBuffer(value)
}


// === FILE: uniffi/coverall/FfiConverterSequenceOptionalTypeCoveralls.kt ===
package uniffi.coverall

object FfiConverterSequenceOptionalTypeCoveralls : FfiConverterRustBuffer<List<Coveralls?>> {
    override fun read(buf: java.nio.ByteBuffer): List<Coveralls?> {
        val len = buf.getInt()
        val list = ArrayList<Coveralls?>(len)
        repeat(len) { list.add(FfiConverterOptionalTypeCoveralls.read(buf)) }
        return list
    }

    override fun allocationSize(value: List<Coveralls?>): Long {
        return 4L + value.sumOf { FfiConverterOptionalTypeCoveralls.allocationSize(it) }
    }

    override fun write(value: List<Coveralls?>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        value.forEach { FfiConverterOptionalTypeCoveralls.write(it, buf) }
    }
}

