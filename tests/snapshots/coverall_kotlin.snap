// FfiConverter routes `Coveralls` across the FFI as an 8-byte
// handle. No callback-interface support — pure Rust-owned object.
object FfiConverterTypeCoveralls : FfiConverter<Coveralls, Long> {
    override fun lower(value: Coveralls): Long = value.uniffiCloneHandle()

    override fun lift(value: Long): Coveralls =
        Coveralls(UniffiWithHandle, value)

    override fun read(buf: java.nio.ByteBuffer): Coveralls = lift(buf.getLong())

    override fun allocationSize(value: Coveralls): Long = 8L

    override fun write(value: Coveralls, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

