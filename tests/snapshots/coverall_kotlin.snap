        handle: Long,
        uniffiOutErr: java.lang.foreign.MemorySegment,
    ) {
        try {
            MH_uniffi_uniffi_coverall_fn_free_coveralls.invokeExact(
                handle,
                uniffiOutErr,
            )
        } catch (ex: Throwable) {
            throw AssertionError("invokeExact failed", ex)
        }
    }

    // uniffi_uniffi_coverall_fn_constructor_coveralls_fallible_new
    private val MH_uniffi_uniffi_coverall_fn_constructor_coveralls_fallible_new: java.lang.invoke.MethodHandle = findDowncallHandle(
        "uniffi_uniffi_coverall_fn_constructor_coveralls_fallible_new",
