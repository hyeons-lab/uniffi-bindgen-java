        return DictWithDefaults(
            FfiConverterString.read(buf),
            FfiConverterOptionalString.read(buf),
            FfiConverterLong.read(buf),
            FfiConverterSequenceString.read(buf),
            FfiConverterMapStringString.read(buf)
        )
    }

    override fun allocationSize(value: DictWithDefaults): Long {
        return (
            FfiConverterString.allocationSize(value.name) +
            FfiConverterOptionalString.allocationSize(value.category) +
            FfiConverterLong.allocationSize(value.integer) +
            FfiConverterSequenceString.allocationSize(value.itemList) +
            FfiConverterMapStringString.allocationSize(value.itemMap)
        )
    }

    override fun write(value: DictWithDefaults, buf: java.nio.ByteBuffer) {
        FfiConverterString.write(value.name, buf)
        FfiConverterOptionalString.write(value.category, buf)
        FfiConverterLong.write(value.integer, buf)
        FfiConverterSequenceString.write(value.itemList, buf)
        FfiConverterMapStringString.write(value.itemMap, buf)
    }
}

