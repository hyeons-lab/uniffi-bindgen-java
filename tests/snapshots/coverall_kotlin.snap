    fun uniffiRustCallShort(callback: UniffiRustCallShortFunction): Short =
        uniffiRustCallWithErrorShort(UniffiNullRustCallStatusErrorHandler(), callback)

    fun interface UniffiRustCallByteFunction {
        fun apply(allocator: java.lang.foreign.SegmentAllocator, status: java.lang.foreign.MemorySegment): Byte
    }

    @Throws(Exception::class)
    fun <E : Exception> uniffiRustCallWithErrorByte(
