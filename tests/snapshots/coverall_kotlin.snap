            }
        }
    }

    
    override fun describeParent(): kotlin.String =
        FfiConverterString.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_node_describe_parent(_allocator, uniffiHandle, _status)
                }
            }
        )
    
    override fun getParent(): NodeTrait? =
        FfiConverterOptionalTypeNodeTrait.lift(
