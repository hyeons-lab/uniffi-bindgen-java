    fun interface UniffiRustCallDoubleFunction {
        fun apply(allocator: java.lang.foreign.SegmentAllocator, status: java.lang.foreign.MemorySegment): Double
    }

    @Throws(Exception::class)
    fun <E : Exception> uniffiRustCallWithErrorDouble(
        errorHandler: UniffiRustCallStatusErrorHandler<E>,
        callback: UniffiRustCallDoubleFunction,
    ): Double {
        val status = REUSABLE_STATUS.get()
