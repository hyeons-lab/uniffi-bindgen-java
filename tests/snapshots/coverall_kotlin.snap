    }

    fun uniffiRustCallInt(callback: UniffiRustCallIntFunction): Int =
        uniffiRustCallWithErrorInt(UniffiNullRustCallStatusErrorHandler(), callback)

    fun interface UniffiRustCallShortFunction {
        fun apply(allocator: java.lang.foreign.SegmentAllocator, status: java.lang.foreign.MemorySegment): Short
    }

    @Throws(Exception::class)
    fun <E : Exception> uniffiRustCallWithErrorShort(
