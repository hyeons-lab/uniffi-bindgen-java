                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_node_get_parent(_allocator, uniffiHandle, _status)
                }
            }
        )
    
    override fun name(): kotlin.String =
        FfiConverterString.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_node_name(_allocator, uniffiHandle, _status)
                }
            }
        )
    
    override fun setParent(parent: NodeTrait?) {
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallVoid { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_node_set_parent(uniffiHandle, FfiConverterOptionalTypeNodeTrait.lower(parent), _status)
            }
        }
    }
    
    override fun strongCount(): kotlin.Long =
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallLong { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_node_strong_count(uniffiHandle, _status)
            }
        }
    

    override fun toString(): String =
        FfiConverterString.lift(callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_node_uniffi_trait_debug(_allocator, uniffiHandle, _status)
            }
        })
}


