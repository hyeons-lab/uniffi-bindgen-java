// === FILE: uniffi/coverall/FfiConverterTypeComplexError.kt ===
package uniffi.coverall

object FfiConverterTypeComplexError : FfiConverterRustBuffer<ComplexException> {
    override fun read(buf: java.nio.ByteBuffer): ComplexException =
        when (buf.getInt()) {
            1 -> ComplexException.OsException(
                FfiConverterShort.read(buf),
                FfiConverterShort.read(buf)
            )
            2 -> ComplexException.PermissionDenied(
                FfiConverterString.read(buf)
            )
            3 -> ComplexException.UnknownException(
            )
            else -> throw RuntimeException("invalid error enum value, something is very wrong!!")
        }

    override fun allocationSize(value: ComplexException): Long =
        when (value) {
            is ComplexException.OsException -> (
                4L
                + FfiConverterShort.allocationSize(value.code)
                + FfiConverterShort.allocationSize(value.extendedCode)
            )
            is ComplexException.PermissionDenied -> (
                4L
                + FfiConverterString.allocationSize(value.reason)
            )
            is ComplexException.UnknownException -> (
                4L
            )
        }

    override fun write(value: ComplexException, buf: java.nio.ByteBuffer) {
        when (value) {
            is ComplexException.OsException -> {
                buf.putInt(1)
                FfiConverterShort.write(value.code, buf)
                FfiConverterShort.write(value.extendedCode, buf)
            }
            is ComplexException.PermissionDenied -> {
                buf.putInt(2)
                FfiConverterString.write(value.reason, buf)
            }
            is ComplexException.UnknownException -> {
                buf.putInt(3)
            }
        }
    }
}


