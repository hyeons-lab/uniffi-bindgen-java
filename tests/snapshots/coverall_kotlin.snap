            is ReturnOnlyEnum.Three -> (
                4L
                + FfiConverterSequenceTypeCoverallFlatError.allocationSize(value.l)
            )
            is ReturnOnlyEnum.Four -> (
                4L
                + FfiConverterMapStringTypeCoverallFlatError.allocationSize(value.m)
            )
        }

    override fun write(value: ReturnOnlyEnum, buf: java.nio.ByteBuffer) {
        when (value) {
            is ReturnOnlyEnum.One -> {
                buf.putInt(1)
                FfiConverterTypeCoverallFlatError.write(value.e, buf)
            }
            is ReturnOnlyEnum.Two -> {
                buf.putInt(2)
                FfiConverterTypeReturnOnlyDict.write(value.d, buf)
            }
            is ReturnOnlyEnum.Three -> {
                buf.putInt(3)
                FfiConverterSequenceTypeCoverallFlatError.write(value.l, buf)
            }
            is ReturnOnlyEnum.Four -> {
                buf.putInt(4)
                FfiConverterMapStringTypeCoverallFlatError.write(value.m, buf)
            }
        }
    }
}


// === FILE: uniffi/coverall/FfiConverterTypeRootError.kt ===
package uniffi.coverall

object FfiConverterTypeRootError : FfiConverterRustBuffer<RootException> {
    override fun read(buf: java.nio.ByteBuffer): RootException =
        when (buf.getInt()) {
            1 -> RootException.Complex(
                FfiConverterTypeComplexError.read(buf)
            )
            2 -> RootException.Other(
                FfiConverterTypeOtherError.read(buf)
            )
            else -> throw RuntimeException("invalid error enum value, something is very wrong!!")
        }

    override fun allocationSize(value: RootException): Long =
        when (value) {
            is RootException.Complex -> (
                4L
                + FfiConverterTypeComplexError.allocationSize(value.error)
            )
            is RootException.Other -> (
                4L
                + FfiConverterTypeOtherError.allocationSize(value.error)
            )
        }

    override fun write(value: RootException, buf: java.nio.ByteBuffer) {
        when (value) {
            is RootException.Complex -> {
                buf.putInt(1)
                FfiConverterTypeComplexError.write(value.error, buf)
            }
            is RootException.Other -> {
                buf.putInt(2)
                FfiConverterTypeOtherError.write(value.error, buf)
            }
        }
    }
}



// === FILE: uniffi/coverall/FfiConverterTypeSimpleDict.kt ===
package uniffi.coverall

object FfiConverterTypeSimpleDict : FfiConverterRustBuffer<SimpleDict> {
    override fun read(buf: java.nio.ByteBuffer): SimpleDict {
        return SimpleDict(
            FfiConverterString.read(buf),
            FfiConverterOptionalString.read(buf),
            FfiConverterByteArray.read(buf),
            FfiConverterOptionalByteArray.read(buf),
            FfiConverterBoolean.read(buf),
            FfiConverterOptionalBoolean.read(buf),
            FfiConverterByte.read(buf),
            FfiConverterOptionalByte.read(buf),
            FfiConverterShort.read(buf),
            FfiConverterOptionalShort.read(buf),
            FfiConverterLong.read(buf),
            FfiConverterOptionalLong.read(buf),
            FfiConverterByte.read(buf),
            FfiConverterOptionalByte.read(buf),
            FfiConverterLong.read(buf),
            FfiConverterOptionalLong.read(buf),
            FfiConverterFloat.read(buf),
            FfiConverterOptionalFloat.read(buf),
            FfiConverterDouble.read(buf),
            FfiConverterOptionalDouble.read(buf),
            FfiConverterOptionalTypeCoveralls.read(buf),
            FfiConverterSequenceOptionalTypeCoveralls.read(buf),
            FfiConverterMapStringOptionalTypeCoveralls.read(buf),
            FfiConverterOptionalTypeNodeTrait.read(buf)
        )
    }

    override fun allocationSize(value: SimpleDict): Long {
        return (
            FfiConverterString.allocationSize(value.text) +
            FfiConverterOptionalString.allocationSize(value.maybeText) +
            FfiConverterByteArray.allocationSize(value.someBytes) +
            FfiConverterOptionalByteArray.allocationSize(value.maybeSomeBytes) +
            FfiConverterBoolean.allocationSize(value.aBool) +
            FfiConverterOptionalBoolean.allocationSize(value.maybeABool) +
            FfiConverterByte.allocationSize(value.unsigned8) +
            FfiConverterOptionalByte.allocationSize(value.maybeUnsigned8) +
            FfiConverterShort.allocationSize(value.unsigned16) +
            FfiConverterOptionalShort.allocationSize(value.maybeUnsigned16) +
            FfiConverterLong.allocationSize(value.unsigned64) +
            FfiConverterOptionalLong.allocationSize(value.maybeUnsigned64) +
            FfiConverterByte.allocationSize(value.signed8) +
            FfiConverterOptionalByte.allocationSize(value.maybeSigned8) +
            FfiConverterLong.allocationSize(value.signed64) +
            FfiConverterOptionalLong.allocationSize(value.maybeSigned64) +
            FfiConverterFloat.allocationSize(value.float32) +
            FfiConverterOptionalFloat.allocationSize(value.maybeFloat32) +
            FfiConverterDouble.allocationSize(value.float64) +
            FfiConverterOptionalDouble.allocationSize(value.maybeFloat64) +
            FfiConverterOptionalTypeCoveralls.allocationSize(value.coveralls) +
            FfiConverterSequenceOptionalTypeCoveralls.allocationSize(value.coverallsList) +
            FfiConverterMapStringOptionalTypeCoveralls.allocationSize(value.coverallsMap) +
            FfiConverterOptionalTypeNodeTrait.allocationSize(value.testTrait)
        )
    }

    override fun write(value: SimpleDict, buf: java.nio.ByteBuffer) {
        FfiConverterString.write(value.text, buf)
        FfiConverterOptionalString.write(value.maybeText, buf)
        FfiConverterByteArray.write(value.someBytes, buf)
        FfiConverterOptionalByteArray.write(value.maybeSomeBytes, buf)
        FfiConverterBoolean.write(value.aBool, buf)
        FfiConverterOptionalBoolean.write(value.maybeABool, buf)
        FfiConverterByte.write(value.unsigned8, buf)
        FfiConverterOptionalByte.write(value.maybeUnsigned8, buf)
        FfiConverterShort.write(value.unsigned16, buf)
        FfiConverterOptionalShort.write(value.maybeUnsigned16, buf)
        FfiConverterLong.write(value.unsigned64, buf)
        FfiConverterOptionalLong.write(value.maybeUnsigned64, buf)
        FfiConverterByte.write(value.signed8, buf)
        FfiConverterOptionalByte.write(value.maybeSigned8, buf)
        FfiConverterLong.write(value.signed64, buf)
        FfiConverterOptionalLong.write(value.maybeSigned64, buf)
        FfiConverterFloat.write(value.float32, buf)
        FfiConverterOptionalFloat.write(value.maybeFloat32, buf)
        FfiConverterDouble.write(value.float64, buf)
        FfiConverterOptionalDouble.write(value.maybeFloat64, buf)
        FfiConverterOptionalTypeCoveralls.write(value.coveralls, buf)
        FfiConverterSequenceOptionalTypeCoveralls.write(value.coverallsList, buf)
        FfiConverterMapStringOptionalTypeCoveralls.write(value.coverallsMap, buf)
        FfiConverterOptionalTypeNodeTrait.write(value.testTrait, buf)
    }
}


// === FILE: uniffi/coverall/FfiConverterTypeSimpleFlatMacroEnum.kt ===
package uniffi.coverall

object FfiConverterTypeSimpleFlatMacroEnum : FfiConverterRustBuffer<SimpleFlatMacroEnum> {
    override fun read(buf: java.nio.ByteBuffer): SimpleFlatMacroEnum =
        when (buf.getInt()) {
            1 -> SimpleFlatMacroEnum.First(
                FfiConverterString.read(buf)
            )
            2 -> SimpleFlatMacroEnum.Second(
                FfiConverterShort.read(buf)
            )
            else -> throw RuntimeException("invalid enum value, something is very wrong!")
        }

    override fun allocationSize(value: SimpleFlatMacroEnum): Long =
        when (value) {
            is SimpleFlatMacroEnum.First -> (
                4L
                + FfiConverterString.allocationSize(value.`val`)
            )
            is SimpleFlatMacroEnum.Second -> (
                4L
                + FfiConverterShort.allocationSize(value.num)
            )
        }

    override fun write(value: SimpleFlatMacroEnum, buf: java.nio.ByteBuffer) {
        when (value) {
            is SimpleFlatMacroEnum.First -> {
                buf.putInt(1)
                FfiConverterString.write(value.`val`, buf)
            }
            is SimpleFlatMacroEnum.Second -> {
                buf.putInt(2)
                FfiConverterShort.write(value.num, buf)
            }
        }
    }
}


// === FILE: uniffi/coverall/FfiConverterTypeStringUtil.kt ===
package uniffi.coverall
// FfiConverter routes `StringUtil` across the FFI as an 8-byte
// handle. No callback-interface support — pure Rust-owned object.
object FfiConverterTypeStringUtil : FfiConverter<StringUtil, Long> {
    override fun lower(value: StringUtil): Long = value.uniffiCloneHandle()

    override fun lift(value: Long): StringUtil =
        StringUtil(UniffiWithHandle, value)

    override fun read(buf: java.nio.ByteBuffer): StringUtil = lift(buf.getLong())

    override fun allocationSize(value: StringUtil): Long = 8L

    override fun write(value: StringUtil, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

