// === FILE: uniffi/coverall/Coveralls.kt ===
package uniffi.coverall

// Object wrapper over a Rust `Arc<T>`. Uses a handle-based protocol
// for cross-FFI lifecycle: the `AtomicLong` call counter + `AtomicBoolean`
// closed flag together implement an in-flight-call guard so close()
// and concurrent method calls can't race into a use-after-free on the
// Rust side.
//
// Structure mirrors `src/templates/ObjectTemplate.java` verbatim at
// the protocol level — same handshake, same Cleaner integration.
// Every Object implements its sibling `<Name>Interface` (method
// signatures only, no `AutoCloseable`); for `[Trait, WithForeign]`
// objects this same interface is the user-facing trait declaration
// that foreign Kotlin classes can implement directly. Methods are
// emitted with `override` in both cases.
class Coveralls internal constructor(
    @Suppress("UNUSED_PARAMETER") phantom: UniffiWithHandle,
    internal val handle: Long,
) : AutoCloseable, CoverallsInterface {
    private val wasDestroyed = java.util.concurrent.atomic.AtomicBoolean(false)
    private val callCounter = java.util.concurrent.atomic.AtomicLong(1L)
    // NoHandle wrappers (handle == 0) don't register a cleaner: there's
    // no Rust peer to free, and registering would just queue a dead
    // Cleanable. Real wrappers register; `cleanable` is nullable so
    // `close()` can tolerate either shape.
    private val cleanable: UniffiCleaner.Cleanable? =
        if (handle != 0L) UniffiLib.CLEANER.register(this, UniffiCleanAction(handle)) else null

    /**
     * Test-only constructor for instantiating a fake wrapper with no
     * connected Rust peer. Any method call on a fake object will fail.
     */
    constructor(@Suppress("UNUSED_PARAMETER") noHandle: NoHandle) : this(UniffiWithHandle, 0L)
    constructor(name: kotlin.String) : this(
        UniffiWithHandle,
        UniffiHelpers.uniffiRustCall { _allocator, _status ->
            UniffiLib.uniffi_uniffi_coverall_fn_constructor_coveralls_new(FfiConverterString.lower(name), _status)
        },
    )

    override fun close() {
        // Single-shot. Subsequent close() calls are silent no-ops.
        if (wasDestroyed.compareAndSet(false, true)) {
            // Match the initial count of 1 given at creation time.
            if (callCounter.decrementAndGet() == 0L) {
                cleanable?.clean()
            }
        }
    }

    /**
     * Run [block] with the live Rust handle, holding the wrapper alive
     * for the duration of the call. Throws `IllegalStateException` if
     * the wrapper has already been destroyed.
     *
     * Uses a CAS retry loop on the call counter so concurrent method
     * calls can run without taking a lock; see the comment block in
     * `src/templates/ObjectTemplate.java` for the full correctness
     * argument.
     *
     * NOT `inline`: the body reads `private` fields (`callCounter`,
     * `cleanable`) and calls `internal fun uniffiCloneHandle()`. A
     * public `inline fun` cannot reference non-public-API members
     * without `@PublishedApi internal` annotations on each one;
     * leaving it as a regular method costs one closure allocation
     * per call (negligible vs the FFI roundtrip) and matches
     * upstream uniffi-rs's Kotlin shape.
     */
    fun <R> callWithHandle(block: (Long) -> R): R {
        // Check and increment the call counter. Retries on CAS failure
        // under concurrent updates.
        var c: Long
        do {
            c = callCounter.get()
            check(c != 0L) { "Coveralls object has already been destroyed" }
            check(c != Long.MAX_VALUE) { "Coveralls call counter would overflow" }
        } while (!callCounter.compareAndSet(c, c + 1L))
        try {
            return block(uniffiCloneHandle())
        } finally {
            if (callCounter.decrementAndGet() == 0L) {
                cleanable?.clean()
            }
        }
    }

    internal fun uniffiCloneHandle(): Long =
        UniffiHelpers.uniffiRustCall { _allocator, _status ->
            if (handle == 0L) {
                throw NullPointerException()
            }
            UniffiLib.uniffi_uniffi_coverall_fn_clone_coveralls(handle, _status)
        }

    // IMPORTANT: NOT `inner class`. A Kotlin `inner class` would capture
    // an implicit reference to the outer wrapper, which would keep the
    // wrapper strongly reachable as long as the Cleaner holds the
    // `Runnable` alive — meaning the wrapper could never become
    // phantom-reachable, the cleaner would never fire, and every
    // forgotten `close()` would leak the Rust handle. Keeping this as a
    // nested class means the Runnable only references the primitive
    // `handle` Long it was constructed with, which is exactly what the
    // Cleaner contract requires.
    private class UniffiCleanAction(private val handle: Long) : Runnable {
        override fun run() {
            // handle == 0 is defense-in-depth: `cleanable` is only
            // registered when handle != 0, so this branch shouldn't
            // be reachable in practice. Leaving the guard in case the
            // class is ever instantiated directly (e.g. by tests).
            if (handle != 0L) {
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_free_coveralls(handle, _status)
                }
            }
        }
    }

    
    override fun addPatch(patch: Patch) {
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallVoid { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_add_patch(uniffiHandle, FfiConverterTypePatch.lower(patch), _status)
            }
        }
    }
    
    override fun addRepair(repair: Repair) {
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallVoid { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_add_repair(uniffiHandle, FfiConverterTypeRepair.lower(repair), _status)
            }
        }
    }
    
    override fun cloneMe(): Coveralls =
        FfiConverterTypeCoveralls.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_clone_me(uniffiHandle, _status)
                }
            }
        )
    
    @Throws(CoverallException::class)
    override fun falliblePanic(message: kotlin.String) {
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallVoidWithError(CoverallExceptionErrorHandler()) { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_fallible_panic(uniffiHandle, FfiConverterString.lower(message), _status)
            }
        }
    }
    
    override fun getDict(key: kotlin.String, `value`: kotlin.Long): Map<kotlin.String, kotlin.Long> =
        FfiConverterMapStringLong.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_get_dict(_allocator, uniffiHandle, FfiConverterString.lower(key), `value`, _status)
                }
            }
        )
    
    override fun getDict2(key: kotlin.String, `value`: kotlin.Long): Map<kotlin.String, kotlin.Long> =
        FfiConverterMapStringLong.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_get_dict2(_allocator, uniffiHandle, FfiConverterString.lower(key), `value`, _status)
                }
            }
        )
    
    override fun getDict3(key: kotlin.Int, `value`: kotlin.Long): Map<kotlin.Int, kotlin.Long> =
        FfiConverterMapIntLong.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_get_dict3(_allocator, uniffiHandle, key, `value`, _status)
                }
            }
        )
    
    override fun getName(): kotlin.String =
        FfiConverterString.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_get_name(_allocator, uniffiHandle, _status)
                }
            }
        )
    
    override fun getOther(): Coveralls? =
        FfiConverterOptionalTypeCoveralls.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_get_other(_allocator, uniffiHandle, _status)
                }
            }
        )
    
    override fun getRepairs(): List<Repair> =
        FfiConverterSequenceTypeRepair.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_get_repairs(_allocator, uniffiHandle, _status)
                }
            }
        )
    
    override fun getStatus(status: kotlin.String): kotlin.String =
        FfiConverterString.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_get_status(_allocator, uniffiHandle, FfiConverterString.lower(status), _status)
                }
            }
        )
    
    @Throws(CoverallException::class)
    override fun maybeThrow(shouldThrow: kotlin.Boolean): kotlin.Boolean =
        FfiConverterBoolean.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCallWithError(CoverallExceptionErrorHandler()) { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_maybe_throw(uniffiHandle, FfiConverterBoolean.lower(shouldThrow), _status)
                }
            }
        )
    
    @Throws(ComplexException::class)
    override fun maybeThrowComplex(input: kotlin.Byte): kotlin.Boolean =
        FfiConverterBoolean.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCallWithError(ComplexExceptionErrorHandler()) { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_maybe_throw_complex(uniffiHandle, input, _status)
                }
            }
        )
    
    @Throws(CoverallException::class)
    override fun maybeThrowInto(shouldThrow: kotlin.Boolean): kotlin.Boolean =
        FfiConverterBoolean.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCallWithError(CoverallExceptionErrorHandler()) { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_maybe_throw_into(uniffiHandle, FfiConverterBoolean.lower(shouldThrow), _status)
                }
            }
        )
    
    override fun panic(message: kotlin.String) {
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallVoid { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_panic(uniffiHandle, FfiConverterString.lower(message), _status)
            }
        }
    }
    
    override fun reverse(`value`: kotlin.ByteArray): kotlin.ByteArray =
        FfiConverterByteArray.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_reverse(_allocator, uniffiHandle, FfiConverterByteArray.lower(`value`), _status)
                }
            }
        )
    
    override fun setAndGetEmptyStruct(emptyStruct: EmptyStruct): EmptyStruct =
        FfiConverterTypeEmptyStruct.lift(
            callWithHandle { uniffiHandle ->
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
                    UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_set_and_get_empty_struct(_allocator, uniffiHandle, FfiConverterTypeEmptyStruct.lower(emptyStruct), _status)
                }
            }
        )
    
    override fun strongCount(): kotlin.Long =
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallLong { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_strong_count(uniffiHandle, _status)
            }
        }
    
    override fun takeOther(other: Coveralls?) {
        callWithHandle { uniffiHandle ->
            UniffiHelpers.uniffiRustCallVoid { _, _status ->
                UniffiLib.uniffi_uniffi_coverall_fn_method_coveralls_take_other(uniffiHandle, FfiConverterOptionalTypeCoveralls.lower(other), _status)
