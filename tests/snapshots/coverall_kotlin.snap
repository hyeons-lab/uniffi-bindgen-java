// === FILE: uniffi/coverall/CoverallsInterface.kt ===
package uniffi.coverall

interface CoverallsInterface {
    fun addPatch(patch: Patch)
    fun addRepair(repair: Repair)
    fun cloneMe(): Coveralls
    @Throws(CoverallException::class)
    fun falliblePanic(message: kotlin.String)
    fun getDict(key: kotlin.String, `value`: kotlin.Long): Map<kotlin.String, kotlin.Long>
    fun getDict2(key: kotlin.String, `value`: kotlin.Long): Map<kotlin.String, kotlin.Long>
    fun getDict3(key: kotlin.Int, `value`: kotlin.Long): Map<kotlin.Int, kotlin.Long>
    fun getName(): kotlin.String
    fun getOther(): Coveralls?
    fun getRepairs(): List<Repair>
    fun getStatus(status: kotlin.String): kotlin.String
    @Throws(CoverallException::class)
    fun maybeThrow(shouldThrow: kotlin.Boolean): kotlin.Boolean
    @Throws(ComplexException::class)
    fun maybeThrowComplex(input: kotlin.Byte): kotlin.Boolean
    @Throws(CoverallException::class)
    fun maybeThrowInto(shouldThrow: kotlin.Boolean): kotlin.Boolean
    fun panic(message: kotlin.String)
    fun reverse(`value`: kotlin.ByteArray): kotlin.ByteArray
    fun setAndGetEmptyStruct(emptyStruct: EmptyStruct): EmptyStruct
    fun strongCount(): kotlin.Long
    fun takeOther(other: Coveralls?)
    @Throws(CoverallException::class)
    fun takeOtherFallible()
    fun takeOtherPanic(message: kotlin.String)
}


