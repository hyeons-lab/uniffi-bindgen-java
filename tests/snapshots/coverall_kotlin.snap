// === FILE: uniffi/coverall/ComplexException.kt ===
package uniffi.coverall

sealed class ComplexException(message: String) : kotlin.Exception(message) {
    class OsException(
        val code: kotlin.Short,
        val extendedCode: kotlin.Short
    ) : ComplexException("code=${code}, extendedCode=${extendedCode}")
    class PermissionDenied(
        val reason: kotlin.String
    ) : ComplexException("reason=${reason}")
    class UnknownException(
    ) : ComplexException("")
}


// === FILE: uniffi/coverall/ComplexExceptionErrorHandler.kt ===
package uniffi.coverall

class ComplexExceptionErrorHandler : UniffiRustCallStatusErrorHandler<ComplexException> {
    override fun lift(errorBuf: java.lang.foreign.MemorySegment): ComplexException =
        FfiConverterTypeComplexError.lift(errorBuf)
}


// === FILE: uniffi/coverall/ComplexMacroException.kt ===
package uniffi.coverall

sealed class ComplexMacroException(message: String) : kotlin.Exception(message) {
    class OsException(
        val code: kotlin.Short,
        val extendedCode: kotlin.Short
    ) : ComplexMacroException("code=${code}, extendedCode=${extendedCode}")
    class PermissionDenied(
        val reason: kotlin.String
    ) : ComplexMacroException("reason=${reason}")
    class UnknownException(
    ) : ComplexMacroException("")
}


