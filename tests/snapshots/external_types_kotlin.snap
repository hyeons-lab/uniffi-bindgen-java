// === FILE: uniffi/imported_types_lib/FfiConverterByteArray.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterByteArray : FfiConverterRustBuffer<ByteArray> {
    override fun read(buf: java.nio.ByteBuffer): ByteArray {
        val len = buf.int
        val arr = ByteArray(len)
        buf.get(arr)
        return arr
    }

    override fun allocationSize(value: ByteArray): Long = (4 + value.size).toLong()

    override fun write(value: ByteArray, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        buf.put(value)
    }
}


