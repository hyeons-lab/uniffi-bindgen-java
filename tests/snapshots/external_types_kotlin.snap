// === FILE: uniffi/imported_types_lib/FfiConverterTypeExternalCrateInterface.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*
// FfiConverter routes `ExternalCrateInterface` across the FFI as an 8-byte
// handle. No callback-interface support — pure Rust-owned object.
object FfiConverterTypeExternalCrateInterface : FfiConverter<ExternalCrateInterface, Long> {
    override fun lower(value: ExternalCrateInterface): Long = value.uniffiCloneHandle()

    override fun lift(value: Long): ExternalCrateInterface =
        ExternalCrateInterface(UniffiWithHandle, value)

    override fun read(buf: java.nio.ByteBuffer): ExternalCrateInterface = lift(buf.getLong())

    override fun allocationSize(value: ExternalCrateInterface): Long = 8L

    override fun write(value: ExternalCrateInterface, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

// === FILE: uniffi/imported_types_lib/FfiConverterTypeExternalCrateNonExhaustiveEnum.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterTypeExternalCrateNonExhaustiveEnum : FfiConverterRustBuffer<ExternalCrateNonExhaustiveEnum> {
    override fun read(buf: java.nio.ByteBuffer): ExternalCrateNonExhaustiveEnum {
        try {
            return ExternalCrateNonExhaustiveEnum.values()[buf.getInt() - 1]
        } catch (e: IndexOutOfBoundsException) {
            throw RuntimeException("invalid enum value, something is very wrong!!", e)
        }
    }

    override fun allocationSize(value: ExternalCrateNonExhaustiveEnum): Long = 4L

    override fun write(value: ExternalCrateNonExhaustiveEnum, buf: java.nio.ByteBuffer) {
        buf.putInt(value.ordinal + 1)
    }
}


// === FILE: uniffi/imported_types_lib/FfiConverterTypeNestedExternalGuid.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// FfiConverter delegating to the builtin's serialization. The wrapper
// just ferries `value` through.
object FfiConverterTypeNestedExternalGuid : FfiConverter<NestedExternalGuid, java.lang.foreign.MemorySegment> {
    override fun lift(value: java.lang.foreign.MemorySegment): NestedExternalGuid =
        NestedExternalGuid(FfiConverterTypeGuid.lift(value))

    override fun lower(value: NestedExternalGuid): java.lang.foreign.MemorySegment =
        FfiConverterTypeGuid.lower(value.value)

    override fun read(buf: java.nio.ByteBuffer): NestedExternalGuid =
        NestedExternalGuid(FfiConverterTypeGuid.read(buf))

    override fun allocationSize(value: NestedExternalGuid): Long =
        FfiConverterTypeGuid.allocationSize(value.value)

    override fun write(value: NestedExternalGuid, buf: java.nio.ByteBuffer) {
        FfiConverterTypeGuid.write(value.value, buf)
    }
}


