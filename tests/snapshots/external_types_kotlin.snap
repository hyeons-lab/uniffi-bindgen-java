// === FILE: uniffi/imported_types_sublib/FfiConverterOptionalTypeUniffiOneInterface.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

// Kotlin uses its type system to express nullability directly via `T?`,
// so the `lift` / `lower` boundary handles a null sentinel byte without
// any wrapper class on the Kotlin side.
object FfiConverterOptionalTypeUniffiOneInterface : FfiConverterRustBuffer<UniffiOneInterface?> {
    override fun read(buf: java.nio.ByteBuffer): UniffiOneInterface? {
        if (buf.get() == 0.toByte()) {
            return null
        }
        return FfiConverterTypeUniffiOneInterface.read(buf)
    }

    override fun allocationSize(value: UniffiOneInterface?): Long {
        if (value == null) {
            return 1L
        }
        return 1L + FfiConverterTypeUniffiOneInterface.allocationSize(value)
    }

    override fun write(value: UniffiOneInterface?, buf: java.nio.ByteBuffer) {
        if (value == null) {
            buf.put(0.toByte())
        } else {
            buf.put(1.toByte())
            FfiConverterTypeUniffiOneInterface.write(value, buf)
        }
    }
}

// === FILE: uniffi/imported_types_sublib/FfiConverterOptionalTypeUniffiOneTrait.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

// Kotlin uses its type system to express nullability directly via `T?`,
// so the `lift` / `lower` boundary handles a null sentinel byte without
// any wrapper class on the Kotlin side.
object FfiConverterOptionalTypeUniffiOneTrait : FfiConverterRustBuffer<UniffiOneTrait?> {
    override fun read(buf: java.nio.ByteBuffer): UniffiOneTrait? {
        if (buf.get() == 0.toByte()) {
            return null
        }
        return FfiConverterTypeUniffiOneTrait.read(buf)
    }

    override fun allocationSize(value: UniffiOneTrait?): Long {
        if (value == null) {
            return 1L
        }
        return 1L + FfiConverterTypeUniffiOneTrait.allocationSize(value)
    }

    override fun write(value: UniffiOneTrait?, buf: java.nio.ByteBuffer) {
        if (value == null) {
            buf.put(0.toByte())
        } else {
            buf.put(1.toByte())
            FfiConverterTypeUniffiOneTrait.write(value, buf)
        }
    }
}

// === FILE: uniffi/imported_types_sublib/FfiConverterRustBuffer.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

// FfiConverter that uses `RustBuffer` as the FfiType.
interface FfiConverterRustBuffer<T> : FfiConverter<T, java.lang.foreign.MemorySegment> {
    override fun lift(value: java.lang.foreign.MemorySegment): T = liftFromRustBuffer(value)
    override fun lower(value: T): java.lang.foreign.MemorySegment = lowerIntoRustBuffer(value)
}


// === FILE: uniffi/imported_types_sublib/FfiConverterShort.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

object FfiConverterShort : FfiConverter<Short, Short> {
    override fun lift(value: Short): Short = value
    override fun read(buf: java.nio.ByteBuffer): Short = buf.short
    override fun lower(value: Short): Short = value
    override fun allocationSize(value: Short): Long = 2L
    override fun write(value: Short, buf: java.nio.ByteBuffer) {
        buf.putShort(value)
    }
}


// === FILE: uniffi/imported_types_sublib/FfiConverterString.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

object FfiConverterString : FfiConverter<String, java.lang.foreign.MemorySegment> {
    // Note: we don't inherit from FfiConverterRustBuffer because we use a
    // special encoding when lowering/lifting. We use `RustBuffer.len` to
    // store the length rather than writing it into the buffer body.
    override fun lift(value: java.lang.foreign.MemorySegment): String =
        try {
            val byteArr = ByteArray(RustBuffer.getLen(value).toInt())
            RustBuffer.asByteBuffer(value).get(byteArr)
            String(byteArr, java.nio.charset.StandardCharsets.UTF_8)
        } finally {
            RustBuffer.free(value)
        }

    override fun read(buf: java.nio.ByteBuffer): String {
        val len = buf.int
        val byteArr = ByteArray(len)
        buf.get(byteArr)
        return String(byteArr, java.nio.charset.StandardCharsets.UTF_8)
    }

    private fun toUtf8(value: String): java.nio.ByteBuffer {
        // Guard against invalid UTF-16 (lone surrogates) so the conversion
        // produces a clean, decodable UTF-8 stream.
        val encoder = java.nio.charset.StandardCharsets.UTF_8.newEncoder()
        encoder.onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
        return try {
            encoder.encode(java.nio.CharBuffer.wrap(value))
        } catch (e: java.nio.charset.CharacterCodingException) {
            throw RuntimeException(e)
        }
    }

    override fun lower(value: String): java.lang.foreign.MemorySegment {
        val byteBuf = toUtf8(value)
        val rbuf = RustBuffer.alloc(byteBuf.limit().toLong())
        RustBuffer.asWriteByteBuffer(rbuf).put(byteBuf)
        RustBuffer.setLen(rbuf, byteBuf.limit().toLong())
        return rbuf
    }

    // We don't know exactly how many bytes the UTF-8 encoding will need,
    // so pessimistically allocate 3 bytes per UTF-16 code unit — always
    // enough even for worst-case surrogate expansions.
    override fun allocationSize(value: String): Long {
        val sizeForLength = 4L
        val sizeForString = value.length.toLong() * 3L
        return sizeForLength + sizeForString
    }

    override fun write(value: String, buf: java.nio.ByteBuffer) {
        val byteBuf = toUtf8(value)
        buf.putInt(byteBuf.limit())
        buf.put(byteBuf)
    }
}


// === FILE: uniffi/imported_types_sublib/FfiConverterTypeNotToThrowError.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

object FfiConverterTypeNotToThrowError : FfiConverterRustBuffer<NotToThrowException> {
    override fun read(buf: java.nio.ByteBuffer): NotToThrowException =
        when (buf.getInt()) {
            1 -> NotToThrowException.Variant(
                FfiConverterLong.read(buf)
            )
            else -> throw RuntimeException("invalid error enum value, something is very wrong!!")
        }

    override fun allocationSize(value: NotToThrowException): Long =
        when (value) {
            is NotToThrowException.Variant -> (
                4L
                + FfiConverterLong.allocationSize(value.v1)
            )
        }

    override fun write(value: NotToThrowException, buf: java.nio.ByteBuffer) {
        when (value) {
            is NotToThrowException.Variant -> {
                buf.putInt(1)
                FfiConverterLong.write(value.v1, buf)
            }
        }
    }
}


// === FILE: uniffi/imported_types_sublib/FfiConverterTypeSubLibType.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

object FfiConverterTypeSubLibType : FfiConverterRustBuffer<SubLibType> {
    override fun read(buf: java.nio.ByteBuffer): SubLibType {
        return SubLibType(
            FfiConverterOptionalTypeUniffiOneEnum.read(buf),
            FfiConverterOptionalTypeUniffiOneTrait.read(buf),
            FfiConverterOptionalTypeUniffiOneInterface.read(buf)
        )
    }

    override fun allocationSize(value: SubLibType): Long {
        return (
            FfiConverterOptionalTypeUniffiOneEnum.allocationSize(value.maybeEnum) +
            FfiConverterOptionalTypeUniffiOneTrait.allocationSize(value.maybeTrait) +
            FfiConverterOptionalTypeUniffiOneInterface.allocationSize(value.maybeInterface)
        )
    }

    override fun write(value: SubLibType, buf: java.nio.ByteBuffer) {
        FfiConverterOptionalTypeUniffiOneEnum.write(value.maybeEnum, buf)
        FfiConverterOptionalTypeUniffiOneTrait.write(value.maybeTrait, buf)
        FfiConverterOptionalTypeUniffiOneInterface.write(value.maybeInterface, buf)
    }
}

// === FILE: uniffi/imported_types_sublib/ForeignBytes.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

// Helper for safely passing byte references into the rust code.
//
// Not actually used yet — there aren't many things you can take a direct
// pointer to in the JVM, and if we're going to copy something we might as
// well copy it into a `RustBuffer`. Here for API completeness.
object ForeignBytes {
    val LAYOUT: java.lang.foreign.StructLayout = java.lang.foreign.MemoryLayout.structLayout(
        java.lang.foreign.ValueLayout.JAVA_INT.withName("len"),
        java.lang.foreign.MemoryLayout.paddingLayout(4),  // alignment padding before ADDRESS
        java.lang.foreign.ValueLayout.ADDRESS.withName("data"),
    )

    private val OFFSET_LEN: Long =
        LAYOUT.byteOffset(java.lang.foreign.MemoryLayout.PathElement.groupElement("len"))
    private val OFFSET_DATA: Long =
        LAYOUT.byteOffset(java.lang.foreign.MemoryLayout.PathElement.groupElement("data"))

    fun getLen(seg: java.lang.foreign.MemorySegment): Int =
        seg.get(java.lang.foreign.ValueLayout.JAVA_INT_UNALIGNED, OFFSET_LEN)

    fun setLen(seg: java.lang.foreign.MemorySegment, value: Int) {
        seg.set(java.lang.foreign.ValueLayout.JAVA_INT_UNALIGNED, OFFSET_LEN, value)
    }

    fun getData(seg: java.lang.foreign.MemorySegment): java.lang.foreign.MemorySegment =
        seg.get(java.lang.foreign.ValueLayout.ADDRESS_UNALIGNED, OFFSET_DATA)

    fun setData(seg: java.lang.foreign.MemorySegment, value: java.lang.foreign.MemorySegment) {
        seg.set(java.lang.foreign.ValueLayout.ADDRESS_UNALIGNED, OFFSET_DATA, value)
    }
}


