// === FILE: uniffi/imported_types_sublib/FfiConverterOptionalTypeSubLibType.kt ===
package uniffi.imported_types_sublib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.uniffi_one_ns.*

// Kotlin uses its type system to express nullability directly via `T?`,
// so the `lift` / `lower` boundary handles a null sentinel byte without
// any wrapper class on the Kotlin side.
object FfiConverterOptionalTypeSubLibType : FfiConverterRustBuffer<SubLibType?> {
    override fun read(buf: java.nio.ByteBuffer): SubLibType? {
        if (buf.get() == 0.toByte()) {
            return null
        }
        return FfiConverterTypeSubLibType.read(buf)
    }

    override fun allocationSize(value: SubLibType?): Long {
        if (value == null) {
            return 1L
        }
        return 1L + FfiConverterTypeSubLibType.allocationSize(value)
    }

    override fun write(value: SubLibType?, buf: java.nio.ByteBuffer) {
        if (value == null) {
            buf.put(0.toByte())
        } else {
            buf.put(1.toByte())
            FfiConverterTypeSubLibType.write(value, buf)
        }
    }
}

