// === FILE: uniffi/uniffi_one_ns/FfiConverterTypeUniffiOneTrait.kt ===
package uniffi.uniffi_one_ns
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
// LSB-tagged FfiConverter for `[Trait, WithForeign]` objects. Rust-side
// instances are wrapped by `UniffiOneTraitImpl` and carry even
// handles (LSB = 0); Kotlin-side implementations of the UniffiOneTrait
// trait get registered in the per-FfiConverter `handleMap` and carry
// odd handles (LSB = 1). `lift` / `lower` dispatch on the LSB to route
// to the right side without an extra type tag.
internal object FfiConverterTypeUniffiOneTrait : FfiConverter<UniffiOneTrait, Long> {
    @JvmField internal val handleMap: UniffiHandleMap<UniffiOneTrait> = UniffiHandleMap()

    override fun lower(value: UniffiOneTrait): Long =
        if (value is UniffiOneTraitImpl) {
            value.uniffiCloneHandle()
        } else {
            handleMap.insert(value)
        }

    override fun lift(value: Long): UniffiOneTrait =
        if ((value and 1L) == 0L) {
            UniffiOneTraitImpl(UniffiWithHandle, value)
        } else {
            handleMap.remove(value)
        }

    override fun read(buf: java.nio.ByteBuffer): UniffiOneTrait = lift(buf.getLong())

    override fun allocationSize(value: UniffiOneTrait): Long = 8L

    override fun write(value: UniffiOneTrait, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

