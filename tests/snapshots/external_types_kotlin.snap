    private val MH_ffi_uniffi_ext_types_lib_uniffi_contract_version: java.lang.invoke.MethodHandle = findDowncallHandle(
        "ffi_uniffi_ext_types_lib_uniffi_contract_version",
        java.lang.foreign.FunctionDescriptor.of(
            java.lang.foreign.ValueLayout.JAVA_INT,
        ),
    )

    fun ffi_uniffi_ext_types_lib_uniffi_contract_version(
    ): Int =
        try {
            MH_ffi_uniffi_ext_types_lib_uniffi_contract_version.invokeExact(
            ) as Int
        } catch (ex: Throwable) {
            throw AssertionError("invokeExact failed", ex)
        }

    

    // Integrity checks + callback-interface vtable registrations.
    // Must run after all MethodHandle fields are initialized (class-init
    // proceeds in textual order).
    init {
        NamespaceLibrary.uniffiCheckContractApiVersion()
        NamespaceLibrary.uniffiCheckApiChecksums()
    }
}


