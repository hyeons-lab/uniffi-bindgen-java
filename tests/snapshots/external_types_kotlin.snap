// === FILE: uniffi/ext_types_custom/FfiConverterMapTypeStringWrapperTypeIntWrapper.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterMapTypeStringWrapperTypeIntWrapper : FfiConverterRustBuffer<Map<StringWrapper, IntWrapper>> {
    override fun read(buf: java.nio.ByteBuffer): Map<StringWrapper, IntWrapper> {
        val len = buf.getInt()
        val map = HashMap<StringWrapper, IntWrapper>(len)
        repeat(len) {
            val k = FfiConverterTypeStringWrapper.read(buf)
            val v = FfiConverterTypeIntWrapper.read(buf)
            map[k] = v
        }
        return map
    }

    override fun allocationSize(value: Map<StringWrapper, IntWrapper>): Long {
        return 4L + value.entries.sumOf {
            FfiConverterTypeStringWrapper.allocationSize(it.key) + FfiConverterTypeIntWrapper.allocationSize(it.value)
        }
    }

    override fun write(value: Map<StringWrapper, IntWrapper>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        for ((k, v) in value) {
            FfiConverterTypeStringWrapper.write(k, buf)
            FfiConverterTypeIntWrapper.write(v, buf)
        }
    }
}


// === FILE: uniffi/ext_types_custom/FfiConverterOptionalTypeANestedGuid.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// Kotlin uses its type system to express nullability directly via `T?`,
// so the `lift` / `lower` boundary handles a null sentinel byte without
// any wrapper class on the Kotlin side.
object FfiConverterOptionalTypeANestedGuid : FfiConverterRustBuffer<ANestedGuid?> {
    override fun read(buf: java.nio.ByteBuffer): ANestedGuid? {
        if (buf.get() == 0.toByte()) {
            return null
        }
        return FfiConverterTypeANestedGuid.read(buf)
    }

    override fun allocationSize(value: ANestedGuid?): Long {
        if (value == null) {
            return 1L
        }
        return 1L + FfiConverterTypeANestedGuid.allocationSize(value)
    }

    override fun write(value: ANestedGuid?, buf: java.nio.ByteBuffer) {
        if (value == null) {
            buf.put(0.toByte())
        } else {
            buf.put(1.toByte())
            FfiConverterTypeANestedGuid.write(value, buf)
        }
    }
}

