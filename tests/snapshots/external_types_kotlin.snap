}


// === FILE: uniffi/uniffi_one_ns/UniffiOneException.kt ===
package uniffi.uniffi_one_ns
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*

sealed class UniffiOneException(message: String) : kotlin.Exception(message) {
    class Oops(
        val v1: kotlin.String
    ) : UniffiOneException("v1=${v1}")
}


