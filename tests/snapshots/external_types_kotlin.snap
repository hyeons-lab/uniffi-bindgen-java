// === FILE: uniffi/ext_types_custom/FfiConverterTypeGuidError.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterTypeGuidError : FfiConverterRustBuffer<GuidException> {
    override fun read(buf: java.nio.ByteBuffer): GuidException {
        return when (buf.getInt()) {
            1 -> GuidException.TooShort(FfiConverterString.read(buf))
            else -> throw RuntimeException("invalid error enum value, something is very wrong!!")
        }
    }

    override fun allocationSize(value: GuidException): Long = 4L

    override fun write(value: GuidException, buf: java.nio.ByteBuffer) {
        when (value) {
            is GuidException.TooShort -> {
                buf.putInt(1)
            }
        }
    }
}




// === FILE: uniffi/ext_types_custom/FfiConverterTypeGuidHelper.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterTypeGuidHelper : FfiConverterRustBuffer<GuidHelper> {
    override fun read(buf: java.nio.ByteBuffer): GuidHelper {
        return GuidHelper(
            FfiConverterTypeGuid.read(buf),
            FfiConverterSequenceTypeGuid.read(buf),
            FfiConverterOptionalTypeGuid.read(buf)
        )
    }

    override fun allocationSize(value: GuidHelper): Long {
        return (
            FfiConverterTypeGuid.allocationSize(value.guid) +
            FfiConverterSequenceTypeGuid.allocationSize(value.guids) +
            FfiConverterOptionalTypeGuid.allocationSize(value.maybeGuid)
        )
    }

    override fun write(value: GuidHelper, buf: java.nio.ByteBuffer) {
        FfiConverterTypeGuid.write(value.guid, buf)
        FfiConverterSequenceTypeGuid.write(value.guids, buf)
        FfiConverterOptionalTypeGuid.write(value.maybeGuid, buf)
    }
}

