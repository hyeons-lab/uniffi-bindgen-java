    // ffi_custom_types_rust_future_cancel_i8
    private val MH_ffi_custom_types_rust_future_cancel_i8: java.lang.invoke.MethodHandle = findDowncallHandle(
        "ffi_custom_types_rust_future_cancel_i8",
        java.lang.foreign.FunctionDescriptor.ofVoid(
            java.lang.foreign.ValueLayout.JAVA_LONG,
