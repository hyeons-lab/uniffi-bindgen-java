// FfiConverter routes `UniffiOneInterface` across the FFI as an 8-byte
// handle. No callback-interface support — pure Rust-owned object.
object FfiConverterTypeUniffiOneInterface : FfiConverter<UniffiOneInterface, Long> {
    override fun lower(value: UniffiOneInterface): Long = value.uniffiCloneHandle()

    override fun lift(value: Long): UniffiOneInterface =
        UniffiOneInterface(UniffiWithHandle, value)

    override fun read(buf: java.nio.ByteBuffer): UniffiOneInterface = lift(buf.getLong())

    override fun allocationSize(value: UniffiOneInterface): Long = 8L

    override fun write(value: UniffiOneInterface, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

