// === FILE: uniffi/ext_types_custom/FfiConverterRustBuffer.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// FfiConverter that uses `RustBuffer` as the FfiType.
interface FfiConverterRustBuffer<T> : FfiConverter<T, java.lang.foreign.MemorySegment> {
    override fun lift(value: java.lang.foreign.MemorySegment): T = liftFromRustBuffer(value)
    override fun lower(value: T): java.lang.foreign.MemorySegment = lowerIntoRustBuffer(value)
}


// === FILE: uniffi/ext_types_custom/FfiConverterSequenceTypeGuid.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterSequenceTypeGuid : FfiConverterRustBuffer<List<Guid>> {
    override fun read(buf: java.nio.ByteBuffer): List<Guid> {
        val len = buf.getInt()
        val list = ArrayList<Guid>(len)
        repeat(len) { list.add(FfiConverterTypeGuid.read(buf)) }
        return list
    }

    override fun allocationSize(value: List<Guid>): Long {
        return 4L + value.sumOf { FfiConverterTypeGuid.allocationSize(it) }
    }

    override fun write(value: List<Guid>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        value.forEach { FfiConverterTypeGuid.write(it, buf) }
    }
}

