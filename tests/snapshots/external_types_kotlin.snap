// === FILE: customtypes/FfiConverterString.kt ===
package customtypes
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterString : FfiConverter<String, java.lang.foreign.MemorySegment> {
    // Note: we don't inherit from FfiConverterRustBuffer because we use a
    // special encoding when lowering/lifting. We use `RustBuffer.len` to
    // store the length rather than writing it into the buffer body.
    override fun lift(value: java.lang.foreign.MemorySegment): String =
        try {
            val byteArr = ByteArray(RustBuffer.getLen(value).toInt())
            RustBuffer.asByteBuffer(value).get(byteArr)
            String(byteArr, java.nio.charset.StandardCharsets.UTF_8)
        } finally {
            RustBuffer.free(value)
        }

    override fun read(buf: java.nio.ByteBuffer): String {
        val len = buf.int
        val byteArr = ByteArray(len)
        buf.get(byteArr)
        return String(byteArr, java.nio.charset.StandardCharsets.UTF_8)
    }

    private fun toUtf8(value: String): java.nio.ByteBuffer {
        // Guard against invalid UTF-16 (lone surrogates) so the conversion
        // produces a clean, decodable UTF-8 stream.
        val encoder = java.nio.charset.StandardCharsets.UTF_8.newEncoder()
        encoder.onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
        return try {
            encoder.encode(java.nio.CharBuffer.wrap(value))
        } catch (e: java.nio.charset.CharacterCodingException) {
            throw RuntimeException(e)
        }
    }

    override fun lower(value: String): java.lang.foreign.MemorySegment {
        val byteBuf = toUtf8(value)
        val rbuf = RustBuffer.alloc(byteBuf.limit().toLong())
        RustBuffer.asWriteByteBuffer(rbuf).put(byteBuf)
        RustBuffer.setLen(rbuf, byteBuf.limit().toLong())
        return rbuf
    }

    // We don't know exactly how many bytes the UTF-8 encoding will need,
    // so pessimistically allocate 3 bytes per UTF-16 code unit — always
    // enough even for worst-case surrogate expansions.
    override fun allocationSize(value: String): Long {
        val sizeForLength = 4L
        val sizeForString = value.length.toLong() * 3L
        return sizeForLength + sizeForString
    }

    override fun write(value: String, buf: java.nio.ByteBuffer) {
        val byteBuf = toUtf8(value)
        buf.putInt(byteBuf.limit())
        buf.put(byteBuf)
    }
}


// === FILE: customtypes/FfiConverterTypeCustomTypesDemo.kt ===
package customtypes
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterTypeCustomTypesDemo : FfiConverterRustBuffer<CustomTypesDemo> {
    override fun read(buf: java.nio.ByteBuffer): CustomTypesDemo {
        return CustomTypesDemo(
            FfiConverterTypeUrl.read(buf),
            FfiConverterTypeHandle.read(buf),
            FfiConverterTypeTimeIntervalMs.read(buf),
            FfiConverterTypeTimeIntervalSecDbl.read(buf),
            FfiConverterTypeTimeIntervalSecFlt.read(buf)
        )
    }

    override fun allocationSize(value: CustomTypesDemo): Long {
        return (
            FfiConverterTypeUrl.allocationSize(value.url) +
            FfiConverterTypeHandle.allocationSize(value.handle) +
            FfiConverterTypeTimeIntervalMs.allocationSize(value.timeIntervalMs) +
            FfiConverterTypeTimeIntervalSecDbl.allocationSize(value.timeIntervalSecDbl) +
            FfiConverterTypeTimeIntervalSecFlt.allocationSize(value.timeIntervalSecFlt)
        )
    }

    override fun write(value: CustomTypesDemo, buf: java.nio.ByteBuffer) {
        FfiConverterTypeUrl.write(value.url, buf)
        FfiConverterTypeHandle.write(value.handle, buf)
        FfiConverterTypeTimeIntervalMs.write(value.timeIntervalMs, buf)
        FfiConverterTypeTimeIntervalSecDbl.write(value.timeIntervalSecDbl, buf)
        FfiConverterTypeTimeIntervalSecFlt.write(value.timeIntervalSecFlt, buf)
    }
}

// === FILE: customtypes/FfiConverterTypeExampleCustomType.kt ===
package customtypes
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// FfiConverter delegating to the builtin's serialization. The wrapper
// just ferries `value` through.
object FfiConverterTypeExampleCustomType : FfiConverter<ExampleCustomType, java.lang.foreign.MemorySegment> {
    override fun lift(value: java.lang.foreign.MemorySegment): ExampleCustomType =
        ExampleCustomType(FfiConverterString.lift(value))

    override fun lower(value: ExampleCustomType): java.lang.foreign.MemorySegment =
        FfiConverterString.lower(value.value)

    override fun read(buf: java.nio.ByteBuffer): ExampleCustomType =
        ExampleCustomType(FfiConverterString.read(buf))

    override fun allocationSize(value: ExampleCustomType): Long =
        FfiConverterString.allocationSize(value.value)

    override fun write(value: ExampleCustomType, buf: java.nio.ByteBuffer) {
        FfiConverterString.write(value.value, buf)
    }
}


// === FILE: customtypes/FfiConverterTypeHandle.kt ===
package customtypes
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// FfiConverter delegating to the builtin's serialization. The wrapper
// just ferries `value` through.
object FfiConverterTypeHandle : FfiConverter<Handle, Long> {
    override fun lift(value: Long): Handle =
        Handle(FfiConverterLong.lift(value))

    override fun lower(value: Handle): Long =
        FfiConverterLong.lower(value.value)

    override fun read(buf: java.nio.ByteBuffer): Handle =
        Handle(FfiConverterLong.read(buf))

    override fun allocationSize(value: Handle): Long =
        FfiConverterLong.allocationSize(value.value)

    override fun write(value: Handle, buf: java.nio.ByteBuffer) {
        FfiConverterLong.write(value.value, buf)
    }
}


