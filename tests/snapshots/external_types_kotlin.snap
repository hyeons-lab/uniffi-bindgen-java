        val seg = allocator.allocate(LAYOUT)
        seg.fill(0.toByte())
        return seg
    }
}


// === FILE: uniffi/uniffi_one_ns/UniffiForeignFutureResultU64.kt ===
package uniffi.uniffi_one_ns
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*

internal object UniffiForeignFutureResultU64 {
    val LAYOUT: java.lang.foreign.StructLayout = java.lang.foreign.MemoryLayout.structLayout(
        java.lang.foreign.ValueLayout.JAVA_LONG.withName("returnValue"),
        UniffiRustCallStatus.LAYOUT.withName("callStatus")
    )
    private val OFFSET_returnValue: Long = LAYOUT.byteOffset(java.lang.foreign.MemoryLayout.PathElement.groupElement("returnValue"))
    private val OFFSET_callStatus: Long = LAYOUT.byteOffset(java.lang.foreign.MemoryLayout.PathElement.groupElement("callStatus"))

    fun getreturnValue(seg: java.lang.foreign.MemorySegment): Long =
        seg.get(java.lang.foreign.ValueLayout.JAVA_LONG_UNALIGNED, OFFSET_returnValue) as Long

    fun setreturnValue(seg: java.lang.foreign.MemorySegment, value: Long) {
        seg.set(java.lang.foreign.ValueLayout.JAVA_LONG_UNALIGNED, OFFSET_returnValue, value)
    }

    fun getcallStatus(seg: java.lang.foreign.MemorySegment): java.lang.foreign.MemorySegment =
        seg.asSlice(OFFSET_callStatus, UniffiRustCallStatus.LAYOUT.byteSize())

    fun setcallStatus(seg: java.lang.foreign.MemorySegment, value: java.lang.foreign.MemorySegment) {
        java.lang.foreign.MemorySegment.copy(value, 0L, seg, OFFSET_callStatus, UniffiRustCallStatus.LAYOUT.byteSize())
    }

    fun allocate(allocator: java.lang.foreign.SegmentAllocator): java.lang.foreign.MemorySegment {
        val seg = allocator.allocate(LAYOUT)
        seg.fill(0.toByte())
        return seg
    }
}


