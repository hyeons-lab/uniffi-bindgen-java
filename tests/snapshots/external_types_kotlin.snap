    // uniffi_uniffi_ext_types_lib_fn_func_get_imported_guid
    private val MH_uniffi_uniffi_ext_types_lib_fn_func_get_imported_guid: java.lang.invoke.MethodHandle = findDowncallHandle(
        "uniffi_uniffi_ext_types_lib_fn_func_get_imported_guid",
