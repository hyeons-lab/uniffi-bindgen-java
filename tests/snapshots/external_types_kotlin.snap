// === FILE: customtypes/FfiConverterOptionalTypeCustomTypesDemo.kt ===
package customtypes
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// Kotlin uses its type system to express nullability directly via `T?`,
// so the `lift` / `lower` boundary handles a null sentinel byte without
// any wrapper class on the Kotlin side.
object FfiConverterOptionalTypeCustomTypesDemo : FfiConverterRustBuffer<CustomTypesDemo?> {
    override fun read(buf: java.nio.ByteBuffer): CustomTypesDemo? {
        if (buf.get() == 0.toByte()) {
            return null
        }
        return FfiConverterTypeCustomTypesDemo.read(buf)
    }

    override fun allocationSize(value: CustomTypesDemo?): Long {
        if (value == null) {
            return 1L
        }
        return 1L + FfiConverterTypeCustomTypesDemo.allocationSize(value)
    }

    override fun write(value: CustomTypesDemo?, buf: java.nio.ByteBuffer) {
        if (value == null) {
            buf.put(0.toByte())
        } else {
            buf.put(1.toByte())
            FfiConverterTypeCustomTypesDemo.write(value, buf)
        }
    }
}


// === FILE: customtypes/FfiConverterRustBuffer.kt ===
package customtypes
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// FfiConverter that uses `RustBuffer` as the FfiType.
interface FfiConverterRustBuffer<T> : FfiConverter<T, java.lang.foreign.MemorySegment> {
    override fun lift(value: java.lang.foreign.MemorySegment): T = liftFromRustBuffer(value)
    override fun lower(value: T): java.lang.foreign.MemorySegment = lowerIntoRustBuffer(value)
}


