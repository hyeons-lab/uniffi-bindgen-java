// === FILE: uniffi/ext_types_custom/FfiConverterTypeInnerObject.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*
// FfiConverter routes `InnerObject` across the FFI as an 8-byte
// handle. No callback-interface support — pure Rust-owned object.
object FfiConverterTypeInnerObject : FfiConverter<InnerObject, Long> {
    override fun lower(value: InnerObject): Long = value.uniffiCloneHandle()

    override fun lift(value: Long): InnerObject =
        InnerObject(UniffiWithHandle, value)

    override fun read(buf: java.nio.ByteBuffer): InnerObject = lift(buf.getLong())

    override fun allocationSize(value: InnerObject): Long = 8L

    override fun write(value: InnerObject, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

