// === FILE: uniffi/ext_types_custom/UniffiCallbackInterfaceGuidCallback.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// Vtable assembly + per-method upcall stubs for callback interfaces.
// Each stub pulls the foreign-side object out of the handle map,
// invokes the requested method, and writes the result back into the
// Rust-provided out-param buffer. Mirrors `src/templates/
// CallbackInterfaceImpl.java`, minus the async and error-in-callback
// paths — those land with P3k / P3l respectively.
internal object UniffiCallbackInterfaceGuidCallback {
    internal val vtable: java.lang.foreign.MemorySegment

    init {
        // Arena.global() is load-bearing: vtables and upcall stubs
        // must outlive every FFI call they participate in. Auto arenas
        // would be reclaimable once a reference escapes into a struct,
        // producing use-after-free with delightful debugging traces.
        vtable = java.lang.foreign.Arena.global().allocate(UniffiVTableCallbackInterfaceGuidCallback.LAYOUT)
        UniffiVTableCallbackInterfaceGuidCallback.setuniffiFree(
            vtable,
            UniffiCallbackInterfaceFree.toUpcallStub(UniffiFree, java.lang.foreign.Arena.global()),
        )
        UniffiVTableCallbackInterfaceGuidCallback.setuniffiClone(
            vtable,
            UniffiCallbackInterfaceClone.toUpcallStub(UniffiClone, java.lang.foreign.Arena.global()),
        )
        UniffiVTableCallbackInterfaceGuidCallback.setrun(
            vtable,
            UniffiCallbackInterfaceGuidCallbackMethod0.toUpcallStub(RunCallback, java.lang.foreign.Arena.global()),
        )
    }

    // Registers the vtable with Rust. Called from UniffiLib init via
    // the generator-collected `initialization_fns()` list.
    fun register() {
        UniffiLib.uniffi_ext_types_custom_fn_init_callback_vtable_guidcallback(vtable)
    }

    internal object RunCallback : UniffiCallbackInterfaceGuidCallbackMethod0.Fn {
        override fun callback(
            uniffiHandle: Long,
            arg: java.lang.foreign.MemorySegment,
            uniffiOutReturn: java.lang.foreign.MemorySegment,
            uniffiCallStatus: java.lang.foreign.MemorySegment,
        ) {
            val uniffiCallStatusReinterpreted = uniffiCallStatus.reinterpret(UniffiRustCallStatus.LAYOUT.byteSize())
            val uniffiObj = FfiConverterTypeGuidCallback.handleMap.get(uniffiHandle)
            val makeCall = java.util.function.Supplier {
                uniffiObj.run(
                    FfiConverterTypeGuid.lift(arg)
                )
            }
            val writeReturn = java.util.function.Consumer<Guid> { uniffiValue ->
                val outReturn = uniffiOutReturn.reinterpret(RustBuffer.LAYOUT.byteSize())
                val lowered = FfiConverterTypeGuid.lower(uniffiValue)
                java.lang.foreign.MemorySegment.copy(lowered, 0L, outReturn, 0L, RustBuffer.LAYOUT.byteSize())
            }
            UniffiHelpers.uniffiTraitInterfaceCall(uniffiCallStatusReinterpreted, makeCall, writeReturn)
        }
    }

    // Free — Rust drops the handle; we remove from the map.
    internal object UniffiFree : UniffiCallbackInterfaceFree.Fn {
        override fun callback(handle: Long) {
            FfiConverterTypeGuidCallback.handleMap.remove(handle)
        }
    }

    // Clone — Rust wants another reference; we clone in the map.
    internal object UniffiClone : UniffiCallbackInterfaceClone.Fn {
        override fun callback(handle: Long): Long =
            FfiConverterTypeGuidCallback.handleMap.clone(handle)
    }
}


