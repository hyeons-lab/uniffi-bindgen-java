        val list = ArrayList<UniffiOneType>(len)
        repeat(len) { list.add(FfiConverterTypeUniffiOneType.read(buf)) }
        return list
    }

    override fun allocationSize(value: List<UniffiOneType>): Long {
        return 4L + value.sumOf { FfiConverterTypeUniffiOneType.allocationSize(it) }
    }

    override fun write(value: List<UniffiOneType>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        value.forEach { FfiConverterTypeUniffiOneType.write(it, buf) }
    }
}

