package uniffi.uniffi_one_ns
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*

object FfiConverterTypeUniffiOneEnum : FfiConverterRustBuffer<UniffiOneEnum> {
    override fun read(buf: java.nio.ByteBuffer): UniffiOneEnum {
        try {
            return UniffiOneEnum.values()[buf.getInt() - 1]
        } catch (e: IndexOutOfBoundsException) {
            throw RuntimeException("invalid enum value, something is very wrong!!", e)
        }
    }

    override fun allocationSize(value: UniffiOneEnum): Long = 4L

    override fun write(value: UniffiOneEnum, buf: java.nio.ByteBuffer) {
        buf.putInt(value.ordinal + 1)
    }
}


// === FILE: uniffi/uniffi_one_ns/FfiConverterTypeUniffiOneError.kt ===
package uniffi.uniffi_one_ns
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*

object FfiConverterTypeUniffiOneError : FfiConverterRustBuffer<UniffiOneException> {
    override fun read(buf: java.nio.ByteBuffer): UniffiOneException =
        when (buf.getInt()) {
            1 -> UniffiOneException.Oops(
                FfiConverterString.read(buf)
            )
            else -> throw RuntimeException("invalid error enum value, something is very wrong!!")
        }

    override fun allocationSize(value: UniffiOneException): Long =
        when (value) {
            is UniffiOneException.Oops -> (
                4L
                + FfiConverterString.allocationSize(value.v1)
            )
        }

    override fun write(value: UniffiOneException, buf: java.nio.ByteBuffer) {
        when (value) {
            is UniffiOneException.Oops -> {
                buf.putInt(1)
                FfiConverterString.write(value.v1, buf)
            }
        }
    }
}


// === FILE: uniffi/uniffi_one_ns/FfiConverterTypeUniffiOneErrorInterface.kt ===
package uniffi.uniffi_one_ns
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
// FfiConverter routes `UniffiOneErrorInterface` across the FFI as an 8-byte
// handle. No callback-interface support — pure Rust-owned object.
object FfiConverterTypeUniffiOneErrorInterface : FfiConverter<UniffiOneErrorInterface, Long> {
    override fun lower(value: UniffiOneErrorInterface): Long = value.uniffiCloneHandle()

    override fun lift(value: Long): UniffiOneErrorInterface =
        UniffiOneErrorInterface(UniffiWithHandle, value)

    override fun read(buf: java.nio.ByteBuffer): UniffiOneErrorInterface = lift(buf.getLong())

    override fun allocationSize(value: UniffiOneErrorInterface): Long = 8L

    override fun write(value: UniffiOneErrorInterface, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

