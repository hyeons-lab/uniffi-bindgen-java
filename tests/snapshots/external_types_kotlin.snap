package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object ExtTypesCustom {


    fun getGuid(`value`: Guid?): Guid =
        FfiConverterTypeGuid.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_guid(_allocator, FfiConverterOptionalTypeGuid.lower(`value`), _status)
            }
        )


    fun getGuidHelper(values: GuidHelper?): GuidHelper =
        FfiConverterTypeGuidHelper.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_guid_helper(_allocator, FfiConverterOptionalTypeGuidHelper.lower(values), _status)
            }
        )


    fun getHandleU8(h: HandleU8?): HandleU8 =
        FfiConverterTypeHandleU8.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_handle_u8(FfiConverterOptionalTypeHandleU8.lower(h), _status)
            }
        )


    fun getMapUsingStringWrapper(maybeMap: MapUsingStringWrapper?): MapUsingStringWrapper =
        FfiConverterTypeMapUsingStringWrapper.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_map_using_string_wrapper(_allocator, FfiConverterOptionalTypeMapUsingStringWrapper.lower(maybeMap), _status)
            }
        )


    fun getNestedGuid(nguid: ANestedGuid?): ANestedGuid =
        FfiConverterTypeANestedGuid.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_nested_guid(_allocator, FfiConverterOptionalTypeANestedGuid.lower(nguid), _status)
            }
        )


    fun getNestedObject(n: NestedObject): NestedObject =
        FfiConverterTypeNestedObject.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_nested_object(FfiConverterTypeNestedObject.lower(n), _status)
            }
        )


    fun getNestedOuid(nouid: ANestedOuid?): ANestedOuid =
        FfiConverterTypeANestedOuid.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_nested_ouid(_allocator, FfiConverterOptionalTypeANestedOuid.lower(nouid), _status)
            }
        )


    fun getNestedRecord(n: NestedRecord): NestedRecord =
        FfiConverterTypeNestedRecord.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_nested_record(_allocator, FfiConverterTypeNestedRecord.lower(n), _status)
            }
        )


    fun getOuid(ouid: Ouid?): Ouid =
        FfiConverterTypeOuid.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_get_ouid(_allocator, FfiConverterOptionalTypeOuid.lower(ouid), _status)
            }
        )


    fun runCallback(callback: GuidCallback): Guid =
        FfiConverterTypeGuid.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_run_callback(_allocator, FfiConverterTypeGuidCallback.lower(callback), _status)
            }
        )


    @Throws(GuidException::class)
    fun tryGetGuid(`value`: Guid?): Guid =
        FfiConverterTypeGuid.lift(
            UniffiHelpers.uniffiRustCallWithError(GuidExceptionErrorHandler()) { _allocator, _status ->
                UniffiLib.uniffi_ext_types_custom_fn_func_try_get_guid(_allocator, FfiConverterOptionalTypeGuid.lower(`value`), _status)
            }
        )
}
// === FILE: uniffi/ext_types_custom/FfiConverter.kt ===
package uniffi.ext_types_custom
import customtypes.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// The FfiConverter interface handles converter types to and from the FFI.
//
// All implementations are public to support external types — when a type is
// external we need to import its FfiConverter.
interface FfiConverter<T, FfiType> {
    // Convert an FFI type to a Kotlin type
    fun lift(value: FfiType): T

    // Convert a Kotlin type to an FFI type
    fun lower(value: T): FfiType

    // Read a Kotlin type from a `ByteBuffer`
    fun read(buf: java.nio.ByteBuffer): T

    // Calculate bytes to allocate when creating a `RustBuffer`.
    //
    // Must return at least as many bytes as `write()` will write. May return
    // more than needed (e.g. for Strings, whose UTF-8 byte count depends on
    // the codepoints, we pessimistically allocate 3 bytes per char). Extra
    // bytes aren't a problem because the RustBuffer is short-lived.
    fun allocationSize(value: T): Long

    // Write a Kotlin type to a `ByteBuffer`
    fun write(value: T, buf: java.nio.ByteBuffer)

    // Lower a value into a `RustBuffer`.
    //
    // This lowers a value into a `RustBuffer` rather than the normal FfiType.
    // Used by the callback interface code — callback returns are always
    // serialized into a `RustBuffer` regardless of their normal FFI type.
    fun lowerIntoRustBuffer(value: T): java.lang.foreign.MemorySegment {
        val rbuf = RustBuffer.alloc(allocationSize(value))
        try {
            val bbuf = RustBuffer.asWriteByteBuffer(rbuf)
            write(value, bbuf)
            RustBuffer.setLen(rbuf, bbuf.position().toLong())
            return rbuf
        } catch (e: Throwable) {
            RustBuffer.free(rbuf)
            throw e
        }
    }

    // Lift a value from a `RustBuffer`.
    //
    // Mostly here for symmetry with `lowerIntoRustBuffer()`. Currently only
    // used by `FfiConverterRustBuffer` below.
    fun liftFromRustBuffer(rbuf: java.lang.foreign.MemorySegment): T {
        val byteBuf = RustBuffer.asByteBuffer(rbuf)
        try {
            val item = read(byteBuf)
            if (byteBuf.hasRemaining()) {
                throw RuntimeException("junk remaining in buffer after lifting, something is very wrong!!")
            }
            return item
        } finally {
            RustBuffer.free(rbuf)
        }
    }
}


