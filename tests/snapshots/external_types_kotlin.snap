    override fun read(buf: java.nio.ByteBuffer): Short = buf.short
    override fun lower(value: Short): Short = value
    override fun allocationSize(value: Short): Long = 2L
    override fun write(value: Short, buf: java.nio.ByteBuffer) {
        buf.putShort(value)
    }
}


// === FILE: uniffi/imported_types_lib/FfiConverterString.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterString : FfiConverter<String, java.lang.foreign.MemorySegment> {
    // Note: we don't inherit from FfiConverterRustBuffer because we use a
    // special encoding when lowering/lifting. We use `RustBuffer.len` to
    // store the length rather than writing it into the buffer body.
    override fun lift(value: java.lang.foreign.MemorySegment): String =
        try {
            val byteArr = ByteArray(RustBuffer.getLen(value).toInt())
            RustBuffer.asByteBuffer(value).get(byteArr)
            String(byteArr, java.nio.charset.StandardCharsets.UTF_8)
        } finally {
            RustBuffer.free(value)
        }

    override fun read(buf: java.nio.ByteBuffer): String {
        val len = buf.int
        val byteArr = ByteArray(len)
        buf.get(byteArr)
        return String(byteArr, java.nio.charset.StandardCharsets.UTF_8)
    }

    private fun toUtf8(value: String): java.nio.ByteBuffer {
        // Guard against invalid UTF-16 (lone surrogates) so the conversion
        // produces a clean, decodable UTF-8 stream.
        val encoder = java.nio.charset.StandardCharsets.UTF_8.newEncoder()
        encoder.onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
        return try {
            encoder.encode(java.nio.CharBuffer.wrap(value))
        } catch (e: java.nio.charset.CharacterCodingException) {
            throw RuntimeException(e)
        }
    }

    override fun lower(value: String): java.lang.foreign.MemorySegment {
        val byteBuf = toUtf8(value)
        val rbuf = RustBuffer.alloc(byteBuf.limit().toLong())
        RustBuffer.asWriteByteBuffer(rbuf).put(byteBuf)
        RustBuffer.setLen(rbuf, byteBuf.limit().toLong())
        return rbuf
    }

    // We don't know exactly how many bytes the UTF-8 encoding will need,
    // so pessimistically allocate 3 bytes per UTF-16 code unit — always
    // enough even for worst-case surrogate expansions.
    override fun allocationSize(value: String): Long {
        val sizeForLength = 4L
        val sizeForString = value.length.toLong() * 3L
        return sizeForLength + sizeForString
    }

    override fun write(value: String, buf: java.nio.ByteBuffer) {
        val byteBuf = toUtf8(value)
        buf.putInt(byteBuf.limit())
        buf.put(byteBuf)
    }
}


// === FILE: uniffi/imported_types_lib/FfiConverterTypeCombinedType.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterTypeCombinedType : FfiConverterRustBuffer<CombinedType> {
    override fun read(buf: java.nio.ByteBuffer): CombinedType {
        return CombinedType(
            FfiConverterTypeUniffiOneEnum.read(buf),
            FfiConverterTypeUniffiOneType.read(buf),
            FfiConverterSequenceTypeUniffiOneType.read(buf),
            FfiConverterOptionalTypeUniffiOneType.read(buf),
            FfiConverterTypeGuid.read(buf),
            FfiConverterSequenceTypeGuid.read(buf),
            FfiConverterOptionalTypeGuid.read(buf),
            FfiConverterTypeUrl.read(buf),
            FfiConverterSequenceTypeUrl.read(buf),
            FfiConverterOptionalTypeUrl.read(buf),
            FfiConverterTypeHandle.read(buf),
            FfiConverterSequenceTypeHandle.read(buf),
            FfiConverterOptionalTypeHandle.read(buf),
            FfiConverterTypeExternalCrateDictionary.read(buf),
            FfiConverterTypeExternalCrateNonExhaustiveEnum.read(buf)
        )
    }

    override fun allocationSize(value: CombinedType): Long {
        return (
            FfiConverterTypeUniffiOneEnum.allocationSize(value.uoe) +
            FfiConverterTypeUniffiOneType.allocationSize(value.uot) +
            FfiConverterSequenceTypeUniffiOneType.allocationSize(value.uots) +
            FfiConverterOptionalTypeUniffiOneType.allocationSize(value.maybeUot) +
            FfiConverterTypeGuid.allocationSize(value.guid) +
            FfiConverterSequenceTypeGuid.allocationSize(value.guids) +
            FfiConverterOptionalTypeGuid.allocationSize(value.maybeGuid) +
            FfiConverterTypeUrl.allocationSize(value.url) +
            FfiConverterSequenceTypeUrl.allocationSize(value.urls) +
            FfiConverterOptionalTypeUrl.allocationSize(value.maybeUrl) +
            FfiConverterTypeHandle.allocationSize(value.handle) +
            FfiConverterSequenceTypeHandle.allocationSize(value.handles) +
            FfiConverterOptionalTypeHandle.allocationSize(value.maybeHandle) +
            FfiConverterTypeExternalCrateDictionary.allocationSize(value.ecd) +
            FfiConverterTypeExternalCrateNonExhaustiveEnum.allocationSize(value.ecnee)
        )
    }

    override fun write(value: CombinedType, buf: java.nio.ByteBuffer) {
        FfiConverterTypeUniffiOneEnum.write(value.uoe, buf)
        FfiConverterTypeUniffiOneType.write(value.uot, buf)
        FfiConverterSequenceTypeUniffiOneType.write(value.uots, buf)
        FfiConverterOptionalTypeUniffiOneType.write(value.maybeUot, buf)
        FfiConverterTypeGuid.write(value.guid, buf)
        FfiConverterSequenceTypeGuid.write(value.guids, buf)
        FfiConverterOptionalTypeGuid.write(value.maybeGuid, buf)
        FfiConverterTypeUrl.write(value.url, buf)
        FfiConverterSequenceTypeUrl.write(value.urls, buf)
        FfiConverterOptionalTypeUrl.write(value.maybeUrl, buf)
        FfiConverterTypeHandle.write(value.handle, buf)
        FfiConverterSequenceTypeHandle.write(value.handles, buf)
        FfiConverterOptionalTypeHandle.write(value.maybeHandle, buf)
        FfiConverterTypeExternalCrateDictionary.write(value.ecd, buf)
        FfiConverterTypeExternalCrateNonExhaustiveEnum.write(value.ecnee, buf)
    }
}

// === FILE: uniffi/imported_types_lib/FfiConverterTypeContainsExternalError.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterTypeContainsExternalError : FfiConverterRustBuffer<ContainsExternalException> {
    override fun read(buf: java.nio.ByteBuffer): ContainsExternalException =
        when (buf.getInt()) {
            1 -> ContainsExternalException.ExternalException(
                FfiConverterTypeNotToThrowError.read(buf)
            )
            else -> throw RuntimeException("invalid error enum value, something is very wrong!!")
        }

    override fun allocationSize(value: ContainsExternalException): Long =
        when (value) {
            is ContainsExternalException.ExternalException -> (
                4L
                + FfiConverterTypeNotToThrowError.allocationSize(value.v1)
            )
        }

    override fun write(value: ContainsExternalException, buf: java.nio.ByteBuffer) {
        when (value) {
            is ContainsExternalException.ExternalException -> {
                buf.putInt(1)
                FfiConverterTypeNotToThrowError.write(value.v1, buf)
            }
        }
    }
}



