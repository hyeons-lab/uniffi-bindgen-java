            throw AssertionError("invokeExact failed", ex)
        }
    }

    // ffi_custom_types_rust_future_free_u8
    private val MH_ffi_custom_types_rust_future_free_u8: java.lang.invoke.MethodHandle = findDowncallHandle(
        "ffi_custom_types_rust_future_free_u8",
        java.lang.foreign.FunctionDescriptor.ofVoid(
            java.lang.foreign.ValueLayout.JAVA_LONG,
        ),
    )

    fun ffi_custom_types_rust_future_free_u8(
        handle: Long,
    ) {
        try {
            MH_ffi_custom_types_rust_future_free_u8.invokeExact(
                handle,
