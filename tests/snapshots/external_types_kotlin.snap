// === FILE: uniffi/imported_types_lib/FfiConverterRustBuffer.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

// FfiConverter that uses `RustBuffer` as the FfiType.
interface FfiConverterRustBuffer<T> : FfiConverter<T, java.lang.foreign.MemorySegment> {
    override fun lift(value: java.lang.foreign.MemorySegment): T = liftFromRustBuffer(value)
    override fun lower(value: T): java.lang.foreign.MemorySegment = lowerIntoRustBuffer(value)
}


// === FILE: uniffi/imported_types_lib/FfiConverterSequenceOptionalTypeUniffiOneEnum.kt ===
package uniffi.imported_types_lib
import customtypes.*
import uniffi.ext_types_custom.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object FfiConverterSequenceOptionalTypeUniffiOneEnum : FfiConverterRustBuffer<List<UniffiOneEnum?>> {
    override fun read(buf: java.nio.ByteBuffer): List<UniffiOneEnum?> {
        val len = buf.getInt()
        val list = ArrayList<UniffiOneEnum?>(len)
        repeat(len) { list.add(FfiConverterOptionalTypeUniffiOneEnum.read(buf)) }
        return list
    }

    override fun allocationSize(value: List<UniffiOneEnum?>): Long {
        return 4L + value.sumOf { FfiConverterOptionalTypeUniffiOneEnum.allocationSize(it) }
    }

    override fun write(value: List<UniffiOneEnum?>, buf: java.nio.ByteBuffer) {
        buf.putInt(value.size)
        value.forEach { FfiConverterOptionalTypeUniffiOneEnum.write(it, buf) }
    }
}

