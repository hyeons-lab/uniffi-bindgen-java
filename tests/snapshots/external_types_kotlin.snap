package customtypes
import uniffi.ext_types_custom.*
import uniffi.imported_types_lib.*
import uniffi.imported_types_sublib.*
import uniffi.uniffi_one_ns.*

object CustomTypes {


    fun getCustomTypesDemo(demo: CustomTypesDemo?): CustomTypesDemo =
        FfiConverterTypeCustomTypesDemo.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_custom_types_fn_func_get_custom_types_demo(_allocator, FfiConverterOptionalTypeCustomTypesDemo.lower(demo), _status)
            }
        )


    fun getExampleCustomType(): ExampleCustomType =
        FfiConverterTypeExampleCustomType.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_custom_types_fn_func_get_example_custom_type(_allocator, _status)
            }
        )
}
