    fun getTraitImpl(): UniffiOneTrait =
        FfiConverterTypeUniffiOneTrait.lift(
            UniffiHelpers.uniffiRustCall { _allocator, _status ->
                UniffiLib.uniffi_uniffi_sublib_fn_func_get_trait_impl(_status)
            }
        )
}
