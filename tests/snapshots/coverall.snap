package uniffi.coverall;

public enum FfiConverterMapIntegerLong implements FfiConverterRustBuffer<java.util.Map<java.lang.Integer, java.lang.Long>> {
    INSTANCE;

    @Override
    public java.util.Map<java.lang.Integer, java.lang.Long> read(java.nio.ByteBuffer buf) {
        int len = buf.getInt();
        // Collectors.toMap would be preferred here, but theres a bug that doesn't allow
        // null values in the map, even though that is valid Java
