// === FILE: uniffi/coverall/CoverallsInterface.java ===
package uniffi.coverall;
public interface CoverallsInterface {
    
    /**
     * Adds a new repair at the current time.
     */public void addPatch(Patch patch);
    
    /**
     * Adds a new repair at the specified time.
     */public void addRepair(Repair repair);
    public Coveralls cloneMe();
    public void falliblePanic(java.lang.String message) throws CoverallException;
    
    /**
     * Simple string->integer dictionary, using the legacy `DOMString` type.
     */public java.util.Map<java.lang.String, java.lang.Long> getDict(java.lang.String key, long value);
    
    /**
     * Simple string->integer dictionary, using the classic string type
     */public java.util.Map<java.lang.String, java.lang.Long> getDict2(java.lang.String key, long value);
    
    /**
     * integer->integer dictionary
     */public java.util.Map<java.lang.Integer, java.lang.Long> getDict3(int key, long value);
    public java.lang.String getName();
    
    /**
     * Returns what was previously set via `take_other()`, or null.
     */public Coveralls getOther();
    
    /**
     * Returns all repairs made.
     */public java.util.List<Repair> getRepairs();
    public java.lang.String getStatus(java.lang.String status);
    public boolean maybeThrow(boolean shouldThrow) throws CoverallException;
    public boolean maybeThrowComplex(byte input) throws ComplexException;
    
    /**
     * Throws something that impls `Into<CoverallError>`,
     * rather than directly throwing `CoverallError`.
     */public boolean maybeThrowInto(boolean shouldThrow) throws CoverallException;
    public void panic(java.lang.String message);
    
    /**
     * Reverses the bytes.
     */public byte[] reverse(byte[] value);
    public EmptyStruct setAndGetEmptyStruct(EmptyStruct emptyStruct);
    
    /**
     * Calls `Arc::strong_count()` on the `Arc` containing `self`.
     */public long strongCount();
    
    /**
     * Takes an `Arc<Self>` and stores it in `self`, dropping the existing
     * reference. Note you can create circular references by passing `self`.
     */public void takeOther(Coveralls other);
    
    /**
     * Same signature as `take_other` but always fails.
     */public void takeOtherFallible() throws CoverallException;
    
    /**
     * Same signature as `take_other` but with an extra string arg - always
     * panics with that message..
     */public void takeOtherPanic(java.lang.String message);
    
}


// === FILE: uniffi/coverall/DictWithDefaults.java ===
package uniffi.coverall;
public class DictWithDefaults {
    private java.lang.String name;
    private java.lang.String category;
    private long integer;
    private java.util.List<java.lang.String> itemList;
    private java.util.Map<java.lang.String, java.lang.String> itemMap;

    public DictWithDefaults(
        java.lang.String name, 
        java.lang.String category, 
        long integer, 
        java.util.List<java.lang.String> itemList, 
        java.util.Map<java.lang.String, java.lang.String> itemMap
    ) {
        
        this.name = name;
        
        this.category = category;
        
        this.integer = integer;
        
        this.itemList = itemList;
        
        this.itemMap = itemMap;
    }
    
    public java.lang.String name() {
        return this.name;
    }
    
    public java.lang.String category() {
        return this.category;
    }
    
    public long integer() {
        return this.integer;
    }
    
    public java.util.List<java.lang.String> itemList() {
        return this.itemList;
    }
    
    public java.util.Map<java.lang.String, java.lang.String> itemMap() {
        return this.itemMap;
    }
    public void setName(java.lang.String name) {
        this.name = name;
    }
    public void setCategory(java.lang.String category) {
        this.category = category;
    }
    public void setInteger(long integer) {
        this.integer = integer;
    }
    public void setItemList(java.util.List<java.lang.String> itemList) {
        this.itemList = itemList;
    }
    public void setItemMap(java.util.Map<java.lang.String, java.lang.String> itemMap) {
        this.itemMap = itemMap;
    }

    

    
    @Override
    public boolean equals(java.lang.Object other) {
        if (other instanceof DictWithDefaults) {
            DictWithDefaults t = (DictWithDefaults) other;
            return (
              java.util.Objects.equals(name, t.name) && 
              
              java.util.Objects.equals(category, t.category) && 
              
              integer == t.integer && 
              
              java.util.Objects.equals(itemList, t.itemList) && 
              
              java.util.Objects.equals(itemMap, t.itemMap)
              
            );
        };
        return false;
    }
    @Override
    public int hashCode() {
        int result = 17;
        result = 31 * result + java.util.Objects.hashCode(name);
        result = 31 * result + java.util.Objects.hashCode(category);
        result = 31 * result + java.lang.Long.hashCode(integer);
        result = 31 * result + java.util.Objects.hashCode(itemList);
        result = 31 * result + java.util.Objects.hashCode(itemMap);
        return result;
    }

    
    
    

}



