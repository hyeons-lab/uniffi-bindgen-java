// === FILE: uniffi/coverall/FfiConverterTypeStringUtil.java ===
package uniffi.coverall;

public enum FfiConverterTypeStringUtil implements FfiConverter<StringUtil, java.lang.Long> {
    INSTANCE;

    @Override
    public java.lang.Long lower(StringUtil value) {
        return value.uniffiCloneHandle();
    }

    @Override
    public StringUtil lift(java.lang.Long value) {
        return new StringUtil(UniffiWithHandle.INSTANCE, value);
    }

    @Override
    public StringUtil read(java.nio.ByteBuffer buf) {
        // The Rust code always writes handles as 8 bytes, and will
        // fail to compile if they don't fit.
        return lift(buf.getLong());
    }

    @Override
    public long allocationSize(StringUtil value) {
        return 8L;
    }

    @Override
    public void write(StringUtil value, java.nio.ByteBuffer buf) {
        // The Rust code always expects handles written as 8 bytes,
        // and will fail to compile if they don't fit.
        buf.putLong(lower(value));
    }
}



