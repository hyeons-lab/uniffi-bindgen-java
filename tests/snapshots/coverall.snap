        java.time.Instant when, 
        Patch patch
    ) {
        
        this.when = when;
        
        this.patch = patch;
    }
    
    public java.time.Instant when() {
        return this.when;
    }
    
    public Patch patch() {
        return this.patch;
    }
    public void setWhen(java.time.Instant when) {
        this.when = when;
    }
    public void setPatch(Patch patch) {
        this.patch = patch;
    }

    
    @Override
    public void close() {
        
    AutoCloseableHelper.close(
        this.when, 
        this.patch);
    }
    

    
    @Override
    public boolean equals(java.lang.Object other) {
        if (other instanceof Repair) {
            Repair t = (Repair) other;
            return (
              java.util.Objects.equals(when, t.when) && 
              
              java.util.Objects.equals(patch, t.patch)
              
            );
        };
        return false;
    }
    @Override
    public int hashCode() {
        int result = 17;
        result = 31 * result + java.util.Objects.hashCode(when);
        result = 31 * result + java.util.Objects.hashCode(patch);
        return result;
    }

    
    
    

}



