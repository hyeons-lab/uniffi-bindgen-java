package uniffi.coverall;
public enum FfiConverterOptionalTypeRootError implements FfiConverterRustBuffer<RootException> {
  INSTANCE;

  @Override
  public RootException read(java.nio.ByteBuffer buf) {
    if (buf.get() == (byte)0) {
      return null;
    }
    return FfiConverterTypeRootError.INSTANCE.read(buf);
  }

  @Override
  public long allocationSize(RootException value) {
    if (value == null) {
      return 1L;
    } else {
      return 1L + FfiConverterTypeRootError.INSTANCE.allocationSize(value);
    }
  }

  @Override
  public void write(RootException value, java.nio.ByteBuffer buf) {
    if (value == null) {
      buf.put((byte)0);
    } else {
      buf.put((byte)1);
      FfiConverterTypeRootError.INSTANCE.write(value, buf);
    }
  }
}



// === FILE: uniffi/coverall/FfiConverterRustBuffer.java ===
package uniffi.coverall;

// FfiConverter that uses `RustBuffer` as the FfiType
public interface FfiConverterRustBuffer<JavaType> extends FfiConverter<JavaType, java.lang.foreign.MemorySegment> {
    @Override
    default JavaType lift(java.lang.foreign.MemorySegment value) {
        return liftFromRustBuffer(value);
    }
    @Override
    default java.lang.foreign.MemorySegment lower(JavaType value) {
        return lowerIntoRustBuffer(value);
    }
}


