  }
}




// === FILE: uniffi/coverall/FfiConverterTypeErrorDict.java ===
package uniffi.coverall;

public enum FfiConverterTypeErrorDict implements FfiConverterRustBuffer<ErrorDict> {
  INSTANCE;

  @Override
  public ErrorDict read(java.nio.ByteBuffer buf) {
    return new ErrorDict(
      FfiConverterOptionalTypeComplexError.INSTANCE.read(buf),
      FfiConverterOptionalTypeRootError.INSTANCE.read(buf),
      FfiConverterSequenceTypeRootError.INSTANCE.read(buf)
    );
  }

  @Override
  public long allocationSize(ErrorDict value) {
      return (
            FfiConverterOptionalTypeComplexError.INSTANCE.allocationSize(value.complexError()) +
            FfiConverterOptionalTypeRootError.INSTANCE.allocationSize(value.rootError()) +
            FfiConverterSequenceTypeRootError.INSTANCE.allocationSize(value.errors())
      );
  }

  @Override
  public void write(ErrorDict value, java.nio.ByteBuffer buf) {
      FfiConverterOptionalTypeComplexError.INSTANCE.write(value.complexError(), buf);
      FfiConverterOptionalTypeRootError.INSTANCE.write(value.rootError(), buf);
      FfiConverterSequenceTypeRootError.INSTANCE.write(value.errors(), buf);
  }
}




