      FfiConverterTypeCoverallFlatError.INSTANCE.write(value.e(), buf);
  }
}




// === FILE: uniffi/coverall/FfiConverterTypeReturnOnlyEnum.java ===
package uniffi.coverall;

public enum FfiConverterTypeReturnOnlyEnum implements FfiConverterRustBuffer<ReturnOnlyEnum> {
    INSTANCE;

    @Override
    public ReturnOnlyEnum read(java.nio.ByteBuffer buf) {
      return switch (buf.getInt()) {
        case 1 -> new ReturnOnlyEnum.One(FfiConverterTypeCoverallFlatError.INSTANCE.read(buf)
          );
        case 2 -> new ReturnOnlyEnum.Two(FfiConverterTypeReturnOnlyDict.INSTANCE.read(buf)
          );
        case 3 -> new ReturnOnlyEnum.Three(FfiConverterSequenceTypeCoverallFlatError.INSTANCE.read(buf)
          );
        case 4 -> new ReturnOnlyEnum.Four(FfiConverterMapStringTypeCoverallFlatError.INSTANCE.read(buf)
          );
        default ->
          throw new java.lang.RuntimeException("invalid enum value, something is very wrong!");
      };
    }

    @Override
    public long allocationSize(ReturnOnlyEnum value) {
        return switch (value) {
          case ReturnOnlyEnum.One(var e) ->
            (4L
            + FfiConverterTypeCoverallFlatError.INSTANCE.allocationSize(e));
          case ReturnOnlyEnum.Two(var d) ->
            (4L
            + FfiConverterTypeReturnOnlyDict.INSTANCE.allocationSize(d));
          case ReturnOnlyEnum.Three(var l) ->
            (4L
            + FfiConverterSequenceTypeCoverallFlatError.INSTANCE.allocationSize(l));
          case ReturnOnlyEnum.Four(var m) ->
            (4L
            + FfiConverterMapStringTypeCoverallFlatError.INSTANCE.allocationSize(m));
        };
    }

    @Override
    public void write(ReturnOnlyEnum value, java.nio.ByteBuffer buf) {
      switch (value) {
        case ReturnOnlyEnum.One(var e) -> {
          buf.putInt(1);
          FfiConverterTypeCoverallFlatError.INSTANCE.write(e, buf);
        }
        case ReturnOnlyEnum.Two(var d) -> {
          buf.putInt(2);
          FfiConverterTypeReturnOnlyDict.INSTANCE.write(d, buf);
        }
        case ReturnOnlyEnum.Three(var l) -> {
          buf.putInt(3);
          FfiConverterSequenceTypeCoverallFlatError.INSTANCE.write(l, buf);
        }
        case ReturnOnlyEnum.Four(var m) -> {
          buf.putInt(4);
          FfiConverterMapStringTypeCoverallFlatError.INSTANCE.write(m, buf);
        }
      };
    }
}






// === FILE: uniffi/coverall/FfiConverterTypeRootError.java ===
package uniffi.coverall;

public enum FfiConverterTypeRootError implements FfiConverterRustBuffer<RootException> {
    INSTANCE;

    @Override
    public RootException read(java.nio.ByteBuffer buf) {

        return switch(buf.getInt()) {
            case 1 -> new RootException.Complex(
                FfiConverterTypeComplexError.INSTANCE.read(buf)
                );
            case 2 -> new RootException.Other(
                FfiConverterTypeOtherError.INSTANCE.read(buf)
                );
            default -> throw new java.lang.RuntimeException("invalid error enum value, something is very wrong!!");
        };
    }

    @Override
    public long allocationSize(RootException value) {
        return switch(value) {
            case RootException.Complex x -> (
                // Add the size for the Int that specifies the variant plus the size needed for all fields
                4L
                + FfiConverterTypeComplexError.INSTANCE.allocationSize(x.error)
            );
            case RootException.Other x -> (
                // Add the size for the Int that specifies the variant plus the size needed for all fields
                4L
                + FfiConverterTypeOtherError.INSTANCE.allocationSize(x.error)
            );
            default -> throw new java.lang.RuntimeException("invalid error enum value, something is very wrong!!");
        };
    }

    @Override
    public void write(RootException value, java.nio.ByteBuffer buf) {
        switch(value) {
            case RootException.Complex x -> {
                buf.putInt(1);
                FfiConverterTypeComplexError.INSTANCE.write(x.error, buf);
            }
            case RootException.Other x -> {
                buf.putInt(2);
                FfiConverterTypeOtherError.INSTANCE.write(x.error, buf);
            }
            default -> throw new java.lang.RuntimeException("invalid error enum value, something is very wrong!!");
        };
    }
}




// === FILE: uniffi/coverall/FfiConverterTypeSimpleDict.java ===
package uniffi.coverall;

public enum FfiConverterTypeSimpleDict implements FfiConverterRustBuffer<SimpleDict> {
  INSTANCE;

  @Override
  public SimpleDict read(java.nio.ByteBuffer buf) {
    return new SimpleDict(
      FfiConverterString.INSTANCE.read(buf),
      FfiConverterOptionalString.INSTANCE.read(buf),
      FfiConverterByteArray.INSTANCE.read(buf),
      FfiConverterOptionalByteArray.INSTANCE.read(buf),
      FfiConverterBoolean.INSTANCE.read(buf),
      FfiConverterOptionalBoolean.INSTANCE.read(buf),
      FfiConverterByte.INSTANCE.read(buf),
      FfiConverterOptionalByte.INSTANCE.read(buf),
      FfiConverterShort.INSTANCE.read(buf),
      FfiConverterOptionalShort.INSTANCE.read(buf),
      FfiConverterLong.INSTANCE.read(buf),
      FfiConverterOptionalLong.INSTANCE.read(buf),
      FfiConverterByte.INSTANCE.read(buf),
      FfiConverterOptionalByte.INSTANCE.read(buf),
      FfiConverterLong.INSTANCE.read(buf),
      FfiConverterOptionalLong.INSTANCE.read(buf),
      FfiConverterFloat.INSTANCE.read(buf),
      FfiConverterOptionalFloat.INSTANCE.read(buf),
      FfiConverterDouble.INSTANCE.read(buf),
      FfiConverterOptionalDouble.INSTANCE.read(buf),
      FfiConverterOptionalTypeCoveralls.INSTANCE.read(buf),
      FfiConverterSequenceOptionalTypeCoveralls.INSTANCE.read(buf),
      FfiConverterMapStringOptionalTypeCoveralls.INSTANCE.read(buf),
      FfiConverterOptionalTypeNodeTrait.INSTANCE.read(buf)
    );
  }

  @Override
  public long allocationSize(SimpleDict value) {
      return (
            FfiConverterString.INSTANCE.allocationSize(value.text()) +
            FfiConverterOptionalString.INSTANCE.allocationSize(value.maybeText()) +
            FfiConverterByteArray.INSTANCE.allocationSize(value.someBytes()) +
            FfiConverterOptionalByteArray.INSTANCE.allocationSize(value.maybeSomeBytes()) +
            FfiConverterBoolean.INSTANCE.allocationSize(value.aBool()) +
            FfiConverterOptionalBoolean.INSTANCE.allocationSize(value.maybeABool()) +
            FfiConverterByte.INSTANCE.allocationSize(value.unsigned8()) +
            FfiConverterOptionalByte.INSTANCE.allocationSize(value.maybeUnsigned8()) +
            FfiConverterShort.INSTANCE.allocationSize(value.unsigned16()) +
            FfiConverterOptionalShort.INSTANCE.allocationSize(value.maybeUnsigned16()) +
            FfiConverterLong.INSTANCE.allocationSize(value.unsigned64()) +
            FfiConverterOptionalLong.INSTANCE.allocationSize(value.maybeUnsigned64()) +
            FfiConverterByte.INSTANCE.allocationSize(value.signed8()) +
            FfiConverterOptionalByte.INSTANCE.allocationSize(value.maybeSigned8()) +
            FfiConverterLong.INSTANCE.allocationSize(value.signed64()) +
            FfiConverterOptionalLong.INSTANCE.allocationSize(value.maybeSigned64()) +
            FfiConverterFloat.INSTANCE.allocationSize(value.float32()) +
            FfiConverterOptionalFloat.INSTANCE.allocationSize(value.maybeFloat32()) +
            FfiConverterDouble.INSTANCE.allocationSize(value.float64()) +
            FfiConverterOptionalDouble.INSTANCE.allocationSize(value.maybeFloat64()) +
            FfiConverterOptionalTypeCoveralls.INSTANCE.allocationSize(value.coveralls()) +
            FfiConverterSequenceOptionalTypeCoveralls.INSTANCE.allocationSize(value.coverallsList()) +
            FfiConverterMapStringOptionalTypeCoveralls.INSTANCE.allocationSize(value.coverallsMap()) +
            FfiConverterOptionalTypeNodeTrait.INSTANCE.allocationSize(value.testTrait())
      );
  }

  @Override
  public void write(SimpleDict value, java.nio.ByteBuffer buf) {
      FfiConverterString.INSTANCE.write(value.text(), buf);
      FfiConverterOptionalString.INSTANCE.write(value.maybeText(), buf);
      FfiConverterByteArray.INSTANCE.write(value.someBytes(), buf);
      FfiConverterOptionalByteArray.INSTANCE.write(value.maybeSomeBytes(), buf);
      FfiConverterBoolean.INSTANCE.write(value.aBool(), buf);
      FfiConverterOptionalBoolean.INSTANCE.write(value.maybeABool(), buf);
      FfiConverterByte.INSTANCE.write(value.unsigned8(), buf);
      FfiConverterOptionalByte.INSTANCE.write(value.maybeUnsigned8(), buf);
      FfiConverterShort.INSTANCE.write(value.unsigned16(), buf);
      FfiConverterOptionalShort.INSTANCE.write(value.maybeUnsigned16(), buf);
      FfiConverterLong.INSTANCE.write(value.unsigned64(), buf);
      FfiConverterOptionalLong.INSTANCE.write(value.maybeUnsigned64(), buf);
      FfiConverterByte.INSTANCE.write(value.signed8(), buf);
      FfiConverterOptionalByte.INSTANCE.write(value.maybeSigned8(), buf);
      FfiConverterLong.INSTANCE.write(value.signed64(), buf);
      FfiConverterOptionalLong.INSTANCE.write(value.maybeSigned64(), buf);
      FfiConverterFloat.INSTANCE.write(value.float32(), buf);
      FfiConverterOptionalFloat.INSTANCE.write(value.maybeFloat32(), buf);
      FfiConverterDouble.INSTANCE.write(value.float64(), buf);
      FfiConverterOptionalDouble.INSTANCE.write(value.maybeFloat64(), buf);
      FfiConverterOptionalTypeCoveralls.INSTANCE.write(value.coveralls(), buf);
      FfiConverterSequenceOptionalTypeCoveralls.INSTANCE.write(value.coverallsList(), buf);
      FfiConverterMapStringOptionalTypeCoveralls.INSTANCE.write(value.coverallsMap(), buf);
      FfiConverterOptionalTypeNodeTrait.INSTANCE.write(value.testTrait(), buf);
  }
}




