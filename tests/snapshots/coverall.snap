package uniffi.coverall;


public class RootException extends java.lang.Exception {
    private RootException(java.lang.String message) {
      super(message);
    }

    
    public static class Complex extends RootException {
      
      ComplexException error;
      public Complex(ComplexException error) {
        super(new StringBuilder()
        .append("error=")
        .append(error)
        
        
        .toString());
        this.error = error;
        }

      public ComplexException error() {
        return this.error;
      }
      
      
      
    }
    
    public static class Other extends RootException {
      
      OtherError error;
      public Other(OtherError error) {
        super(new StringBuilder()
        .append("error=")
        .append(error)
        
        
        .toString());
        this.error = error;
        }

      public OtherError error() {
        return this.error;
      }
      
      
      
    }
     
}


