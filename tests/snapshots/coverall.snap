// === FILE: uniffi/coverall/NodeInterface.java ===
package uniffi.coverall;
public interface NodeInterface {
    public java.lang.String describeParent();
    public NodeTrait getParent();
    public java.lang.String name();
    public void setParent(NodeTrait parent);
    public long strongCount();
    
}


// === FILE: uniffi/coverall/NodeTrait.java ===
package uniffi.coverall;
public interface NodeTrait {
    
    /**
     * Returns what was previously set via `set_parent()`, or null.
     */public NodeTrait getParent();
    public java.lang.String name();
    
    /**
     * Takes an `Arc<Self>` and stores it our parent node, dropping any existing / reference. Note
     * you can create circular references with this.
     */public void setParent(NodeTrait parent);
    
    /**
     * Calls `Arc::strong_count()` on the `Arc` containing `self`.
     */public long strongCount();
    
}


