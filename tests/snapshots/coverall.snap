package uniffi.coverall;

public enum FfiConverterTypeNodeTrait implements FfiConverter<NodeTrait, java.lang.Long> {
    INSTANCE;

    public final UniffiHandleMap<NodeTrait> handleMap = new UniffiHandleMap<>();

    @Override
    public java.lang.Long lower(NodeTrait value) {
        if (value instanceof NodeTraitImpl) {
            // Rust-implemented object. Clone the handle and return it.
            return ((NodeTraitImpl) value).uniffiCloneHandle();
        } else {
            // Java object, generate a new handle and return that.
            return handleMap.insert(value);
        }
    }

    @Override
    public NodeTrait lift(java.lang.Long value) {
        // Check the LSB: Rust handles have LSB = 0, Java handles have LSB = 1
        if ((value & 1L) == 0L) {
            // Rust-generated handle
            return new NodeTraitImpl(UniffiWithHandle.INSTANCE, value);
        } else {
            // Java-generated handle - remove from handleMap (handles are single-use)
            return handleMap.remove(value);
        }
    }

    @Override
    public NodeTrait read(java.nio.ByteBuffer buf) {
        // The Rust code always writes handles as 8 bytes, and will
        // fail to compile if they don't fit.
        return lift(buf.getLong());
    }

    @Override
    public long allocationSize(NodeTrait value) {
        return 8L;
    }

    @Override
    public void write(NodeTrait value, java.nio.ByteBuffer buf) {
        // The Rust code always expects handles written as 8 bytes,
        // and will fail to compile if they don't fit.
        buf.putLong(lower(value));
    }
}



