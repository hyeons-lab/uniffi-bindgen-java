// === FILE: uniffi/coverall/ComplexException.java ===
package uniffi.coverall;


public class ComplexException extends java.lang.Exception {
    private ComplexException(java.lang.String message) {
      super(message);
    }

    
    public static class OsException extends ComplexException {
      
      java.lang.Short code;
      
      java.lang.Short extendedCode;
      public OsException(java.lang.Short code, java.lang.Short extendedCode) {
        super(new StringBuilder()
        .append("code=")
        .append(code)
        
        .append(", ")
        
        
        .append("extendedCode=")
        .append(extendedCode)
        
        
        .toString());
        this.code = code;
        this.extendedCode = extendedCode;
        }

      public java.lang.Short code() {
        return this.code;
      }
      public java.lang.Short extendedCode() {
        return this.extendedCode;
      }
      
      
      
    }
    
    public static class PermissionDenied extends ComplexException {
      
      java.lang.String reason;
      public PermissionDenied(java.lang.String reason) {
        super(new StringBuilder()
        .append("reason=")
        .append(reason)
        
        
        .toString());
        this.reason = reason;
        }

      public java.lang.String reason() {
        return this.reason;
      }
      
      
      
    }
    
    public static class UnknownException extends ComplexException {
      public UnknownException() {
        super(new StringBuilder()
        .toString());
        }

      
      
      
    }
     
}


// === FILE: uniffi/coverall/ComplexExceptionErrorHandler.java ===
package uniffi.coverall;

public class ComplexExceptionErrorHandler implements UniffiRustCallStatusErrorHandler<ComplexException> {
  @Override
  public ComplexException lift(java.lang.foreign.MemorySegment errorBuf){
     return FfiConverterTypeComplexError.INSTANCE.lift(errorBuf);
  }
}


