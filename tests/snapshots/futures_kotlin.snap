    // uniffi_uniffi_futures_fn_method_asyncparser_try_from_string
    private val MH_uniffi_uniffi_futures_fn_method_asyncparser_try_from_string: java.lang.invoke.MethodHandle = findDowncallHandle(
        "uniffi_uniffi_futures_fn_method_asyncparser_try_from_string",
