            // registered when handle != 0, so this branch shouldn't
            // be reachable in practice. Leaving the guard in case the
            // class is ever instantiated directly (e.g. by tests).
            if (handle != 0L) {
                UniffiHelpers.uniffiRustCall { _allocator, _status ->
