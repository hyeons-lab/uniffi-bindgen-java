}


// === FILE: uniffi/fixture/futures/FfiConverterTypeAsyncParser.kt ===
package uniffi.fixture.futures
// LSB-tagged FfiConverter for `[Trait, WithForeign]` objects. Rust-side
// instances are wrapped by `AsyncParserImpl` and carry even
// handles (LSB = 0); Kotlin-side implementations of the AsyncParser
// trait get registered in the per-FfiConverter `handleMap` and carry
// odd handles (LSB = 1). `lift` / `lower` dispatch on the LSB to route
// to the right side without an extra type tag.
internal object FfiConverterTypeAsyncParser : FfiConverter<AsyncParser, Long> {
    @JvmField internal val handleMap: UniffiHandleMap<AsyncParser> = UniffiHandleMap()

    override fun lower(value: AsyncParser): Long =
        if (value is AsyncParserImpl) {
            value.uniffiCloneHandle()
        } else {
            handleMap.insert(value)
        }

    override fun lift(value: Long): AsyncParser =
        if ((value and 1L) == 0L) {
            AsyncParserImpl(UniffiWithHandle, value)
        } else {
            handleMap.remove(value)
        }

    override fun read(buf: java.nio.ByteBuffer): AsyncParser = lift(buf.getLong())

    override fun allocationSize(value: AsyncParser): Long = 8L

    override fun write(value: AsyncParser, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}


