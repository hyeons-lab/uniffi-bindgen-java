// === FILE: uniffi/enum_types/FfiConverterTypeAnimalNamedEnum.kt ===
package uniffi.enum_types

object FfiConverterTypeAnimalNamedEnum : FfiConverterRustBuffer<AnimalNamedEnum> {
    override fun read(buf: java.nio.ByteBuffer): AnimalNamedEnum =
        when (buf.getInt()) {
            1 -> AnimalNamedEnum.None
            2 -> AnimalNamedEnum.Dog(
                FfiConverterTypeAnimalObject.read(buf)
            )
            3 -> AnimalNamedEnum.Cat(
                FfiConverterTypeAnimalRecord.read(buf)
            )
            else -> throw RuntimeException("invalid enum value, something is very wrong!")
        }

    override fun allocationSize(value: AnimalNamedEnum): Long =
        when (value) {
            is AnimalNamedEnum.None -> (
                4L
            )
            is AnimalNamedEnum.Dog -> (
                4L
                + FfiConverterTypeAnimalObject.allocationSize(value.`object`)
            )
            is AnimalNamedEnum.Cat -> (
                4L
                + FfiConverterTypeAnimalRecord.allocationSize(value.record)
            )
        }

    override fun write(value: AnimalNamedEnum, buf: java.nio.ByteBuffer) {
        when (value) {
            is AnimalNamedEnum.None -> {
                buf.putInt(1)
            }
            is AnimalNamedEnum.Dog -> {
                buf.putInt(2)
                FfiConverterTypeAnimalObject.write(value.`object`, buf)
            }
            is AnimalNamedEnum.Cat -> {
                buf.putInt(3)
                FfiConverterTypeAnimalRecord.write(value.record, buf)
            }
        }
    }
}



