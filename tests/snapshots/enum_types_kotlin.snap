package uniffi.enum_types

object FfiConverterTypeAnimalNoReprInt : FfiConverterRustBuffer<AnimalNoReprInt> {
    override fun read(buf: java.nio.ByteBuffer): AnimalNoReprInt {
        try {
            return AnimalNoReprInt.values()[buf.getInt() - 1]
        } catch (e: IndexOutOfBoundsException) {
            throw RuntimeException("invalid enum value, something is very wrong!!", e)
        }
    }

    override fun allocationSize(value: AnimalNoReprInt): Long = 4L

    override fun write(value: AnimalNoReprInt, buf: java.nio.ByteBuffer) {
        buf.putInt(value.ordinal + 1)
    }
}



// === FILE: uniffi/enum_types/FfiConverterTypeAnimalObject.kt ===
package uniffi.enum_types
// FfiConverter routes `AnimalObject` across the FFI as an 8-byte
// handle. No callback-interface support — pure Rust-owned object.
object FfiConverterTypeAnimalObject : FfiConverter<AnimalObject, Long> {
    override fun lower(value: AnimalObject): Long = value.uniffiCloneHandle()

    override fun lift(value: Long): AnimalObject =
        AnimalObject(UniffiWithHandle, value)

    override fun read(buf: java.nio.ByteBuffer): AnimalObject = lift(buf.getLong())

    override fun allocationSize(value: AnimalObject): Long = 8L

    override fun write(value: AnimalObject, buf: java.nio.ByteBuffer) {
        buf.putLong(lower(value))
    }
}

// === FILE: uniffi/enum_types/FfiConverterTypeAnimalRecord.kt ===
package uniffi.enum_types

object FfiConverterTypeAnimalRecord : FfiConverterRustBuffer<AnimalRecord> {
    override fun read(buf: java.nio.ByteBuffer): AnimalRecord {
        return AnimalRecord(
            FfiConverterString.read(buf)
        )
    }

    override fun allocationSize(value: AnimalRecord): Long {
        return (
            FfiConverterString.allocationSize(value.name)
        )
    }

    override fun write(value: AnimalRecord, buf: java.nio.ByteBuffer) {
        FfiConverterString.write(value.name, buf)
    }
}


